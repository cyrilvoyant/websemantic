{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "city",
    "summary",
    "sources",
    "facts",
    "hypotheses"
  ],
  "properties": {
    "city": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "retrieved_at",
          "status"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string"
          },
          "status": {
            "enum": [
              "consulted",
              "unavailable"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "consulted"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ]
            }
          }
        ]
      }
    }
  }
}
