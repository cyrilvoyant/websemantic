wsem:rank rdfs:label "rank"@en .
wsem:repository rdfs:label "repository"@en .
wsem:requiresAcceptance rdfs:label "requires acceptance"@en .
wsem:requiresInstance rdfs:label "requires instance"@en .
wsem:requiresParameter rdfs:label "requires parameter"@en .
wsem:sourceNote rdfs:label "source note"@en .
wsem:supportedBy rdfs:label "supported by"@en .
wsem:supportsTask rdfs:label "supports task"@en .
wsem:temporalSupport rdfs:label "temporal support"@en .
wsem:term rdfs:label "term"@en .
wsem:validityFlag rdfs:label "validity flag"@en .
wsem:value rdfs:label "value"@en .

########################################################################
# Definitions of the remaining core terms (FOOPS VOC4), written from their use in descriptors, scenarios and shapes.
########################################################################
wsem:Aggregation rdfs:comment "How an output value summarises its native values: per step, per course, sum, mean, median across realisations or maximum. Fixes which values can be added or compared."@en .
wsem:BoundAuthority rdfs:comment "Origin of a bound: the backend code itself, a profile policy of the contract, or a scientific source. A code bound cannot be relaxed by the contract."@en .
wsem:DataOrigin rdfs:comment "Nature of the data behind a value or output, e.g. synthetic simulation, user statement or measurement. Simulated outputs are never presented as measurements."@en .
wsem:Execution rdfs:comment "Controlled run of a pinned backend on a validated scenario, producing simulation outputs and a manifest."@en .
wsem:Request rdfs:comment "Natural-language request of a user, kept verbatim as the source of the evidence spans that support provided values."@en .
wsem:Scenario rdfs:comment "Machine-readable configuration built from a request: task, parameters with origin and acceptance, and experiment settings. Only a validated scenario is executed."@en .
wsem:SimulationOutput rdfs:comment "Result produced by an execution (series, indicators, flags), linked to its scenario, software revision and qualification."@en .
wsem:UnknownValue rdfs:comment "Parameter whose value is neither given, derived, nor accepted; it blocks execution and leads to a clarification."@en .
wsem:UserValue rdfs:comment "Parameter value stated in the request, or an exact unit conversion of a stated value, supported by evidence from the request."@en .
wsem:Validation rdfs:comment "Activity checking a scenario against the contract before execution: types, units, bounds, complete groups, acceptance and relational shapes."@en .
wsem:accepted rdfs:comment "True when the user explicitly accepted a proposed default or convention; an unaccepted proposal cannot be executed."@en .
wsem:boundValue rdfs:comment "Numerical limit of a bound, in the canonical unit of the parameter."@en .
wsem:conceptDOI rdfs:comment "DOI that resolves to all versions of an archived software or dataset (Zenodo concept DOI)."@en .
wsem:derivationRule rdfs:comment "Documented rule linking a quantity to others (e.g. total dose = dose per fraction x fractions). Documentary; executed checks are the SHACL shapes and the Python gate."@en .
wsem:evidenceText rdfs:comment "Exact span of the request that supports a value; quoted, never paraphrased."@en .
wsem:fieldPath rdfs:comment "Path of the field in the published scenario JSON (e.g. inputs.length_m, courses[k].dose_per_fraction)."@en .
wsem:pinnedRevision rdfs:comment "Exact source revision (commit or tag) of the backend used for execution."@en .
wsem:proposedValue rdfs:comment "Numerical value that a qualitative convention proposes for a parameter, in its canonical unit, pending acceptance."@en .
wsem:rank rdfs:comment "Position of a qualitative term on the shared ordinal scale (1 very low to 5 very high); carries no number by itself."@en .
wsem:repository rdfs:comment "URL of the original source repository of a software."@en .
wsem:requiresAcceptance rdfs:comment "True when a convention may only be proposed and must be accepted by the user before execution."@en .
wsem:sourceNote rdfs:comment "Short statement of the source or rationale of a convention, default or bound."@en .
wsem:validityFlag rdfs:comment "Name of the backend flag that marks an output as invalid or saturated (e.g. Result.oar_total_valid); flagged values are not reported as valid results."@en .
wsem:value rdfs:comment "Value of a parameter in a scenario, expressed in the canonical unit of its definition."@en .
wsem:acceptedBy rdfs:comment "Links a hypothesis to the explicit acceptance that allows its use in execution."@en .
wsem:aggregation rdfs:comment "Links an output variable to the aggregation that defines it."@en .
wsem:appliesTo rdfs:comment "Links a qualifier mapping or clarification policy to the parameter it concerns."@en .
wsem:authority rdfs:comment "Links a bound to its authority (code, profile policy or source)."@en .
wsem:concept rdfs:comment "Links a parameter value in a scenario to the parameter definition that gives its meaning, unit and bounds."@en .
wsem:dataOrigin rdfs:comment "Links a value or output to the nature of its data (simulated, stated, measured)."@en .
wsem:declaresOutput rdfs:comment "Links a contract to an output variable it publishes with quantity, unit and aggregation."@en .
wsem:declaresParameter rdfs:comment "Links a contract to a parameter definition it publishes."@en .
wsem:declaresValidityLimit rdfs:comment "Links a contract to a declared limit of validity or use (e.g. not a medical device)."@en .
wsem:excludesTask rdfs:comment "Links a contract to a task profile it explicitly refuses (e.g. patient treatment decision)."@en .
wsem:followsConvention rdfs:comment "Links a hypothesis to the qualitative convention it applies."@en .
wsem:forTask rdfs:comment "Links a scenario to the supported task profile it instantiates."@en .
wsem:fromRequest rdfs:comment "Links evidence to the request it is quoted from."@en .
wsem:hasBound rdfs:comment "Links a parameter definition to one of its bounds."@en .
wsem:hasContract rdfs:comment "Links a software to its semantic contract."@en .
wsem:hasExperiment rdfs:comment "Links a scenario to its experiment settings (period, step, realisations, seed or solver settings)."@en .
wsem:hasParameter rdfs:comment "Links a scenario to one of its parameter values."@en .
wsem:producesOutput rdfs:comment "Links a task profile to an output variable it produces."@en .
wsem:qualifiedBy rdfs:comment "Links a simulation output to its qualification (quantity, unit, support, origin, limits)."@en .
wsem:supportedBy rdfs:comment "Links a user value to the request evidence that supports it."@en .
wsem:supportsTask rdfs:comment "Links a contract to a task profile it supports."@en .
wsem:term rdfs:comment "Links a qualifier mapping to the qualitative term of the shared scale that it interprets."@en .


# ---- domain extension ----
@prefix wsem:   <https://w3id.org/websemantic/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .

# LQL-Equiv extension: instances of the common core only (no new classes).
# Source: docs/lql-contract-definitions.md (draft, scientific review pending).

wsem:TaskFractionationEquivalence
    wsem:requiresParameter wsem:LQL_organ, wsem:LQL_tumour_site, wsem:LQL_dose_per_fraction,
                         wsem:LQL_n_fractions, wsem:LQL_reference_dose ;
    wsem:producesOutput wsem:LQL_bed_oar, wsem:LQL_eqd_oar, wsem:LQL_eqd_oar_total, wsem:LQL_ntcp ;
    skos:note "BED, EQD and probabilities are compared one quantity at a time; never concatenated."@en .

wsem:LQLContract wsem:declaresParameter wsem:LQL_organ, wsem:LQL_tumour_site, wsem:LQL_dose_per_fraction,
        wsem:LQL_n_fractions, wsem:LQL_gap_days, wsem:LQL_reference_dose, wsem:LQL_bifractionated, wsem:LQL_total_dose ;
    wsem:declaresOutput wsem:LQL_bed_oar, wsem:LQL_eqd_oar, wsem:LQL_eqd_oar_total, wsem:LQL_eqd_tumour, wsem:LQL_eqd_tumour_total,
        wsem:LQL_ntcp, wsem:LQL_oar_saturated, wsem:LQL_tumour_saturated, wsem:LQL_saturated .

wsem:LQL_organ a wsem:ParameterDefinition ;
    skos:prefLabel "Organe à risque"@fr ; wsem:apiVariable "compute(organ, ...) positional 1" ; wsem:fieldPath "organ" ;
    skos:definition "Organ at risk from the shipped library (34 entries); never chosen silently."@en .

wsem:LQL_tumour_site a wsem:ParameterDefinition ;
    skos:prefLabel "Site tumoral"@fr ; wsem:apiVariable "compute(..., tumour, ...) positional 2" ; wsem:fieldPath "tumour_site" ;
    skos:definition "Tumour site from the shipped library (20 entries)."@en .

wsem:LQL_dose_per_fraction a wsem:ParameterDefinition ; wsem:requiresInstance true ;
    skos:prefLabel "Dose par fraction"@fr ; wsem:apiVariable "Course.dose_per_fraction" ; wsem:fieldPath "courses[k].dose_per_fraction" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ;
    wsem:hasBound [ a wsem:Bound ; wsem:boundKind "min" ; wsem:boundValue 0.0 ; wsem:authority wsem:AuthorityCode ] .

wsem:LQL_n_fractions a wsem:ParameterDefinition ; wsem:requiresInstance true ;
    skos:prefLabel "Nombre de fractions"@fr ; wsem:apiVariable "Course.n_fractions" ; wsem:fieldPath "courses[k].n_fractions" ;
    wsem:quantityKind qk:Dimensionless ; wsem:canonicalUnit unit:NUM ;
    wsem:hasBound [ a wsem:Bound ; wsem:boundKind "min" ; wsem:boundValue 0.0 ; wsem:authority wsem:AuthorityCode ] ,
                [ a wsem:Bound ; wsem:boundKind "min" ; wsem:boundValue 1 ; wsem:authority wsem:AuthorityPolicy ;
                  rdfs:comment "Integer >= 1 for physical schedules (profile policy); the API accepts floats."@en ] .

wsem:LQL_gap_days a wsem:ParameterDefinition ; wsem:requiresInstance true ;
    skos:prefLabel "Interruption"@fr ; wsem:apiVariable "Course.gap_days" ; wsem:fieldPath "courses[k].gap_days" ;
    wsem:quantityKind qk:Time ; wsem:canonicalUnit unit:DAY ;
    wsem:hasBound [ a wsem:Bound ; wsem:boundKind "min" ; wsem:boundValue 0.0 ; wsem:authority wsem:AuthorityCode ] .

wsem:LQL_reference_dose a wsem:ParameterDefinition ;
    skos:prefLabel "Dose de référence par fraction"@fr ; wsem:apiVariable "Prescription.reference_dose" ; wsem:fieldPath "reference_dose" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ; wsem:codeDefault 2.0 ;
    skos:definition "Defines the EQD reference fractionation; always stated in answers."@en ;
    wsem:hasBound [ a wsem:Bound ; wsem:boundKind "min" ; wsem:boundValue 0.0 ; wsem:authority wsem:AuthorityCode ] ,
                [ a wsem:Bound ; wsem:boundKind "min_exclusive" ; wsem:boundValue 0.0 ; wsem:authority wsem:AuthorityPolicy ;
                  rdfs:comment "0 is constructible but does not guarantee a computable EQD."@en ] .

wsem:LQL_bifractionated a wsem:ParameterDefinition ;
    skos:prefLabel "Deux fractions par jour"@fr ; wsem:apiVariable "Prescription.bifractionated" ; wsem:fieldPath "bifractionated" ;
    wsem:codeDefault false .

wsem:LQL_total_dose a wsem:ParameterDefinition ; wsem:requiresInstance true ;
    skos:prefLabel "Dose totale"@fr ; wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ;
    wsem:derivedFrom wsem:LQL_dose_per_fraction, wsem:LQL_n_fractions ;
    wsem:derivationRule "total_dose = dose_per_fraction * n_fractions; a stated total that disagrees is a conflict" .

wsem:LQL_bed_oar a wsem:OutputVariable ;
    skos:prefLabel "BED organe"@fr ; wsem:apiVariable "CourseResult.bed_oar" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ; wsem:aggregation wsem:AggPerCourse ;
    wsem:additive true ; wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_eqd_oar a wsem:OutputVariable ;
    skos:prefLabel "EQD organe"@fr ; wsem:apiVariable "CourseResult.eqd_oar" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ; wsem:aggregation wsem:AggPerCourse ;
    wsem:dependsOnReference wsem:LQL_reference_dose ; wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_eqd_oar_total a wsem:OutputVariable ;
    skos:prefLabel "EQD organe cumulée"@fr ; wsem:apiVariable "Result.eqd_oar_total" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ; wsem:aggregation wsem:AggSum ;
    wsem:dependsOnReference wsem:LQL_reference_dose ; wsem:validityFlag "Result.oar_total_valid" ;
    wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_ntcp a wsem:OutputVariable ;
    skos:prefLabel "NTCP"@fr ; wsem:apiVariable "Result.ntcp_percent" ; wsem:canonicalUnit unit:PERCENT ;
    skos:definition "Model estimate for research and education, not a patient-specific probability."@en ;
    wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_eqd_tumour a wsem:OutputVariable ;
    skos:prefLabel "EQD tumeur"@fr ; wsem:apiVariable "CourseResult.eqd_tumour" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ; wsem:aggregation wsem:AggPerCourse ;
    wsem:dependsOnReference wsem:LQL_reference_dose ; wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_eqd_tumour_total a wsem:OutputVariable ;
    skos:prefLabel "EQD tumeur cumulée"@fr ; wsem:apiVariable "Result.eqd_tumour_total" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ; wsem:aggregation wsem:AggSum ;
    wsem:dependsOnReference wsem:LQL_reference_dose ; wsem:validityFlag "Result.tumour_total_valid" ;
    wsem:dataOrigin wsem:SyntheticSimulation .

# Per-course backend flags invalidate the matching per-course output only.
wsem:LQL_oar_saturated a wsem:OutputVariable ;
    skos:prefLabel "Saturation EQD organe (cours)"@fr ; wsem:apiVariable "CourseResult.oar_saturated" ;
    wsem:invalidates wsem:LQL_eqd_oar .

wsem:LQL_tumour_saturated a wsem:OutputVariable ;
    skos:prefLabel "Saturation EQD tumeur (cours)"@fr ; wsem:apiVariable "CourseResult.tumour_saturated" ;
    wsem:invalidates wsem:LQL_eqd_tumour .

# Global summary flag: true if any course flag is true. It signals a problem but
# does not by itself identify which output is invalid, so it invalidates nothing directly.
wsem:LQL_saturated a wsem:OutputVariable ;
    skos:prefLabel "Saturation (résumé global)"@fr ; wsem:apiVariable "Result.saturated" ;
    rdfs:comment "Any-course summary of CourseResult.oar_saturated / tumour_saturated; read the per-course flags."@en .

# Qualitative expressions
wsem:LQL_conventional a wsem:QualifierMapping ;
    wsem:term wsem:LevelTypical ; skos:altLabel "fractionnement conventionnel"@fr, "classique"@fr ;
    wsem:appliesTo wsem:LQL_dose_per_fraction ; wsem:proposedValue 2.0 ; wsem:requiresAcceptance true ;
    wsem:sourceNote "Conventional fractionation, 2 Gy per fraction; proposal to accept." .

wsem:LQL_hypo_moderate a wsem:ClarificationPolicy ;
    skos:altLabel "hypofractionnement modéré"@fr ; wsem:appliesTo wsem:LQL_dose_per_fraction ;
    rdfs:comment "No numerical convention before sourced review: the user states the dose per fraction."@en .

wsem:LQL_hypo_extreme a wsem:ClarificationPolicy ;
    skos:altLabel "hypofractionnement extrême"@fr, "stéréotaxique"@fr ; wsem:appliesTo wsem:LQL_dose_per_fraction .

wsem:LQL_hyperfractionation a wsem:ClarificationPolicy ;
    skos:altLabel "hyperfractionnement"@fr ; wsem:appliesTo wsem:LQL_bifractionated ;
    rdfs:comment "The word alone does not fix two sessions a day."@en .

# Outputs and flags exposed by the single-course profile of the LQL descriptor (aligned on its ontology_concept names).
wsem:LQLContract wsem:declaresOutput wsem:LQL_bed_tumour, wsem:LQL_tcp_percent, wsem:LQL_cancer_risk,
        wsem:LQL_overall_days_oar, wsem:LQL_overall_days_tumour, wsem:LQL_oar_total_valid, wsem:LQL_tumour_total_valid .

wsem:LQL_bed_tumour a wsem:OutputVariable ;
    skos:prefLabel "BED tumeur"@fr ; wsem:apiVariable "CourseResult.bed_tumour" ;
    wsem:quantityKind qk:AbsorbedDose ; wsem:canonicalUnit unit:GRAY ; wsem:aggregation wsem:AggPerCourse ;
    wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_tcp_percent a wsem:OutputVariable ;
    skos:prefLabel "TCP"@fr ; wsem:apiVariable "Result.tcp_percent" ; wsem:canonicalUnit unit:PERCENT ;
    skos:definition "Model estimate for research and education; sigmoid stated by Options.tcp_model."@en ;
    wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_cancer_risk a wsem:OutputVariable ;
    skos:prefLabel "Indice de risque de cancer radio-induit"@fr ; wsem:apiVariable "Result.cancer_risk" ;
    skos:definition "Native model index from tabulated coefficients; not a clinical percentage; None when the tissue has no coefficients."@en ;
    wsem:dataOrigin wsem:SyntheticSimulation .

wsem:LQL_overall_days_oar a wsem:OutputVariable ;
    skos:prefLabel "Durée calendaire (organe)"@fr ; wsem:apiVariable "CourseResult.overall_days_oar" ;
    wsem:quantityKind qk:Time ; wsem:canonicalUnit unit:DAY ; wsem:aggregation wsem:AggPerCourse .

wsem:LQL_overall_days_tumour a wsem:OutputVariable ;
    skos:prefLabel "Durée calendaire (tumeur)"@fr ; wsem:apiVariable "CourseResult.overall_days_tumour" ;
    wsem:quantityKind qk:Time ; wsem:canonicalUnit unit:DAY ; wsem:aggregation wsem:AggPerCourse .

# Validity flags: true means valid (inverse polarity of the saturation flags).
wsem:LQL_oar_total_valid a wsem:OutputVariable ;
    skos:prefLabel "Validité du total organe"@fr ; wsem:apiVariable "Result.oar_total_valid" ;
    rdfs:comment "True when the cumulative organ EQD is defined; when false, LQL_eqd_oar_total must not be reported."@en .

wsem:LQL_tumour_total_valid a wsem:OutputVariable ;
    skos:prefLabel "Validité du total tumeur"@fr ; wsem:apiVariable "Result.tumour_total_valid" ;
    rdfs:comment "True when the cumulative tumour EQD is defined; when false, LQL_eqd_tumour_total must not be reported."@en .

# --- Schedule comparison and anatomical groups (descriptor: comparison_task, anatomical_groups).
# Groups are SKOS collections over the exact library names; membership never selects the organ at risk.
wsem:TaskScheduleComparison a wsem:TaskProfile ;
    rdfs:label "Compare fictitious schedules for one target, a list of targets or an anatomical group"@en ;
    wsem:requiresParameter wsem:LQL_organ, wsem:LQL_tumour_site, wsem:LQL_dose_per_fraction, wsem:LQL_n_fractions, wsem:LQL_reference_dose ;
    wsem:producesOutput wsem:LQL_tcp_percent, wsem:LQL_ntcp, wsem:LQL_eqd_tumour_total, wsem:LQL_eqd_oar_total, wsem:LQL_bed_tumour ;
    wsem:derivationRule "A schedule is better for a target only if it dominates: TCP >= and NTCP <= with at least one strict inequality; otherwise trade-off. Never a clinical recommendation." ;
    skos:note "Same organ at risk and same reference dose for all schedules; one result row per target and schedule."@en .

wsem:LQLContract wsem:supportsTask wsem:TaskScheduleComparison .

wsem:LQL_qualitative_policy a wsem:ClarificationPolicy ;
    wsem:appliesTo wsem:LQL_dose_per_fraction, wsem:LQL_n_fractions ;
    rdfs:comment "Any qualitative dose, session or fractionation wording is asked, never converted (except the conventional 2 Gy proposal)."@en .

wsem:LQL_AnatomyScheme a skos:ConceptScheme ; skos:prefLabel "Groupes anatomiques LQL-Equiv"@fr .

wsem:LQL_group_thoracic a skos:Collection ; skos:prefLabel "Thorax (cibles et organes thoraciques)"@fr ; skos:altLabel "thoracique"@fr, "thorax"@fr, "cibles thoraciques"@fr, "volumes cibles thoraciques"@fr ;
    skos:member wsem:LQL_site_Lung, wsem:LQL_site_Oesophagus, wsem:LQL_site_Breast_carcinoma, wsem:LQL_organ_Heart, wsem:LQL_organ_Lung, wsem:LQL_organ_Oesophagus, wsem:LQL_organ_Spinal_cord, wsem:LQL_organ_Brachial_plexus, wsem:LQL_organ_Rib_cage .
wsem:LQL_site_Lung a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Lung" ; skos:note "tumour_site value of LQL_tumour_site" .
wsem:LQL_site_Oesophagus a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Oesophagus" ; skos:note "tumour_site value of LQL_tumour_site" .
wsem:LQL_site_Breast_carcinoma a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Breast carcinoma" ; skos:note "tumour_site value of LQL_tumour_site" .
wsem:LQL_organ_Heart a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Heart" ; skos:note "organ value of LQL_organ" .
wsem:LQL_organ_Lung a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Lung" ; skos:note "organ value of LQL_organ" .
wsem:LQL_organ_Oesophagus a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Oesophagus" ; skos:note "organ value of LQL_organ" .
wsem:LQL_organ_Spinal_cord a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Spinal cord" ; skos:note "organ value of LQL_organ" .
wsem:LQL_organ_Brachial_plexus a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Brachial plexus" ; skos:note "organ value of LQL_organ" .
wsem:LQL_organ_Rib_cage a skos:Concept ; skos:inScheme wsem:LQL_AnatomyScheme ; skos:prefLabel "Rib cage" ; skos:note "organ value of LQL_organ" .
