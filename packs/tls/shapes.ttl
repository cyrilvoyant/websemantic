@prefix wsem:   <https://w3id.org/websemantic/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# SHACL shapes executed over a scenario graph merged with the ontology.
# Generic shapes (any domain): numeric type, declared bounds, complete groups;
# they read wsem:hasBound and wsem:partOfGroup from the graph.
# Domain-specific shapes: LQL total dose (d x n) and pyrcel RH/S0 conversion;
# they name their concepts and encode the rule, they do not execute
# wsem:derivationRule strings. Repeated groups (courses, aerosol modes) are
# checked per wsem:groupInstance, never across instances.

wsem:PrefixDecl a owl:Ontology ;
    sh:declare [ sh:prefix "wsem" ; sh:namespace "https://w3id.org/websemantic/ns#"^^xsd:anyURI ] .

wsem:ParameterRecordShape a sh:NodeShape ;
    sh:targetClass wsem:Parameter ;
    sh:property [ sh:path wsem:concept ; sh:minCount 1 ; sh:maxCount 1 ; sh:class wsem:ParameterDefinition ;
                  sh:message "Each record refers to exactly one known parameter definition." ] ;
    sh:property [ sh:path wsem:value ; sh:maxCount 1 ;
                  sh:message "A record carries at most one value; competing values are conflicts, not duplicates." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Record of a repeated parameter lacks wsem:groupInstance (course or mode identifier)." ;
        sh:prefixes wsem:PrefixDecl ;
        sh:select """
            SELECT $this WHERE {
              $this wsem:concept ?c . ?c wsem:requiresInstance true .
              FILTER NOT EXISTS { $this wsem:groupInstance ?k }
            }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Numeric value expected for a parameter with a canonical unit." ;
        sh:prefixes wsem:PrefixDecl ;
        sh:select """
            SELECT $this ?value WHERE {
              $this wsem:value ?value ; wsem:concept ?c . ?c wsem:canonicalUnit ?u .
              FILTER ( !isNumeric(?value) )
            }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Value violates a declared bound ({?kind} {?bound})." ;
        sh:prefixes wsem:PrefixDecl ;
        sh:select """
            SELECT $this ?value ?kind ?bound WHERE {
              $this wsem:value ?value ; wsem:concept ?c .
              ?c wsem:hasBound ?b . ?b wsem:boundKind ?kind ; wsem:boundValue ?bound .
              FILTER ( (?kind = "min" && ?value < ?bound) || (?kind = "max" && ?value > ?bound) ||
                       (?kind = "min_exclusive" && ?value <= ?bound) || (?kind = "max_exclusive" && ?value >= ?bound) )
            }""" ] .

wsem:DerivedQuantityShape a sh:NodeShape ;
    sh:targetClass wsem:Scenario ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Stated total dose of a course disagrees with its dose per fraction x number of fractions (conflict to resolve)." ;
        sh:prefixes wsem:PrefixDecl ;
        sh:select """
            SELECT $this WHERE {
              $this wsem:hasParameter ?t, ?d, ?n .
              ?t wsem:concept wsem:LQL_total_dose ; wsem:value ?tv ; wsem:groupInstance ?k .
              ?d wsem:concept wsem:LQL_dose_per_fraction ; wsem:value ?dv ; wsem:groupInstance ?k .
              ?n wsem:concept wsem:LQL_n_fractions ; wsem:value ?nv ; wsem:groupInstance ?k .
              FILTER ( ABS(?tv - ?dv * ?nv) > 1e-9 )
            }""" ] .

wsem:SameQuantityShape a sh:NodeShape ;
    sh:targetClass wsem:Scenario ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Relative humidity and initial supersaturation describe one state and disagree (S0 must equal RH_fraction - 1)." ;
        sh:prefixes wsem:PrefixDecl ;
        sh:select """
            SELECT $this WHERE {
              $this wsem:hasParameter ?h, ?s .
              ?h wsem:concept wsem:PYR_RH ; wsem:value ?rh .
              ?s wsem:concept wsem:PYR_S0 ; wsem:value ?s0 .
              wsem:PYR_RH wsem:convertibleTo wsem:PYR_S0 .
              FILTER ( ABS(?s0 - (?rh - 1.0)) > 1e-9 )
            }""" ] .

wsem:CompleteGroupShape a sh:NodeShape ;
    sh:targetClass wsem:Scenario ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Incomplete parameter group ({?group}, instance {?k}): all members must be supplied together." ;
        sh:prefixes wsem:PrefixDecl ;
        sh:select """
            SELECT DISTINCT $this ?group ?k WHERE {
              $this wsem:hasParameter ?r . ?r wsem:concept ?c ; wsem:groupInstance ?k . ?c wsem:partOfGroup ?group .
              ?m wsem:partOfGroup ?group .
              FILTER NOT EXISTS { $this wsem:hasParameter ?r2 . ?r2 wsem:concept ?m ; wsem:groupInstance ?k }
            }""" ] .
