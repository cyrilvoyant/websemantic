<https://w3id.org/websemantic/ns#tls/n_lanes_per_tube> a skos:Concept ;
    skos:altLabel "nombre de voies par tube"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
