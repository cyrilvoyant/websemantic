    wsem:modelComponent "lighting" ;
    wsem:quantity "category" ;
    wsem:unitAlias "",
        "1",
        "None",
        "categorical",
        "categorie",
        "category",
        "catégorie",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    wsem:unitSymbol "catégorie" .

