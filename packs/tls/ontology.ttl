    skos:definition "Saison du calendrier simulé ; ne prouve pas une couverture annuelle."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    wsem:concept <https://w3id.org/websemantic/ns#tls/season> ;
    wsem:quantity "category" .

<https://w3id.org/websemantic/ns#tls/p10> a skos:Concept ;
    skos:prefLabel "p10" .

<https://w3id.org/websemantic/ns#tls/p90> a skos:Concept ;
    skos:prefLabel "p90" .

<https://w3id.org/websemantic/ns#tls/pollution_event> a skos:Concept ;
    skos:prefLabel "pollution_event" .

<https://w3id.org/websemantic/ns#tls/seed> a skos:Concept ;
    skos:prefLabel "seed" .

<https://w3id.org/websemantic/ns#tls/start_date> a skos:Concept ;
    skos:altLabel "date de début"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/experiment> ;
    skos:definition "Date de début au format YYYY-MM-DD ; détermine le calendrier, les jours de semaine et les saisons du modèle."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.start_date" ;
    skos:prefLabel "Début"@fr ;
    skos:scopeNote "Demander une date ou une référence temporelle explicite. « Tôt », « tard » et « début d’année » sans année ne déterminent pas une date. Ne pas choisir silencieusement la date du jour. Le défaut est une proposition acceptée seulement sur accord."@fr,
        "Pas de fuseau déclaré ; le profil de lumière saisonnier est celui du modèle, pas une éphéméride du site."@fr ;
    wsem:dataType "date" ;
    wsem:defaultValue "2025-01-01" ;
    wsem:fieldPath "experiment.start_date" ;
    wsem:implementationReference "simulator.py:run_monte_carlo" ;
    wsem:modelComponent "experiment" ;
    wsem:quantity "calendar_date" ;
    wsem:unitAlias "",
        "1",
        "ISO8601",
        "None",
        "YYYY-MM-DD",
        "date",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    wsem:unitSymbol "date" .

<https://w3id.org/websemantic/ns#tls/traffic_index> a skos:Concept ;
    skos:prefLabel "traffic_index" .

<https://w3id.org/websemantic/ns#tls/ventilation_kw> a skos:Concept ;
    skos:prefLabel "ventilation_kw" .

<https://w3id.org/websemantic/ns#tls/base_seed> a skos:Concept ;
    skos:altLabel "graine aléatoire"@fr,
        "seed"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/experiment> ;
    skos:definition "Identifiant initial du générateur pseudo-aléatoire ; chaque réalisation utilise base_seed + run."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.base_seed" ;
    skos:prefLabel "base_seed",
        "Graine"@fr ;
    skos:scopeNote "Identifiant technique fixe à 42 par autorisation antérieure, modifiable uniquement sur demande explicite chiffrée. Faible, forte, meilleure ou nouvelle graine ne désignent pas une intensité physique ; demander une valeur. Ne pas proposer de graine qualitative."@fr,
        "Valeur fixe 42 selon la politique d’essai, modifiable explicitement ; ce n’est pas un paramètre physique."@fr ;
    wsem:boundAuthority "policy" ;
    wsem:dataType "int" ;
    wsem:defaultAuthorization "Politique de reproductibilité des essais : graine initiale fixe à 42, modifiable sur demande explicite." ;
    wsem:defaultValue 42 ;
    wsem:fieldPath "experiment.base_seed" ;
    wsem:implementationReference "simulator.py:run_monte_carlo" ;
    wsem:minimum 0 ;
    wsem:modelComponent "operational" ;
    wsem:operationalDefault true ;
    wsem:quantity "identifier" ;
    wsem:unitAlias "",
        "1",
        "None",
        "id",
        "identifiant",
        "identifier",
        "nombre",
        "null",
        "number",
        "sans dimension",
        "sans unité",
        "unit:NUM",
        "unit:UNITLESS" ;
    wsem:unitSymbol "identifiant" .

