# ---- domain extension ----
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ws: <https://github.com/cyrilvoyant/websemantic/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ws:ComparisonActivity a rdfs:Class ;
    rdfs:subClassOf prov:Activity .

ws:Hypothesis a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:Intent a rdfs:Class .

ws:OperationalSetting a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:Parameter a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

ws:Scenario a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

ws:SimulationOutput a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

ws:UserValue a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:accepted a rdf:Property ;
    rdfs:comment "Acceptation explicite de l'hypothèse."@fr ;
    rdfs:domain ws:Parameter ;
    rdfs:range rdfs:Literal .

ws:aggregation a rdf:Property ;
    rdfs:comment "Méthode de regroupement de la table calculée."@fr .

ws:allowedValue a rdf:Property ;
    rdfs:comment "Valeur catégorielle autorisée."@fr .

ws:boundAuthority a rdf:Property ;
    rdfs:comment "Origine déclarée de la borne ; code ou politique du prototype."@fr .

ws:canonicalUnitToken a rdf:Property ;
    rdfs:comment "Identifiant d'unité utilisé par le contrôle Python."@fr .

ws:concept a rdf:Property ;
    rdfs:comment "Relie un enregistrement à la définition du paramètre."@fr ;
    rdfs:domain rdfs:Resource ;
    rdfs:range skos:Concept .

ws:dataType a rdf:Property ;
    rdfs:comment "Type attendu par le contrôle déterministe."@fr .

ws:defaultAuthorization a rdf:Property ;
    rdfs:comment "Source de l’autorisation du défaut technique fixe."@fr .

ws:defaultValue a rdf:Property ;
    rdfs:comment "Proposition du profil ; jamais acceptée automatiquement par le graphe."@fr .

ws:evidence a rdf:Property ;
    rdfs:comment "Extrait exact de la demande ; présence ne prouve pas la justesse sémantique."@fr .

ws:fieldPath a rdf:Property ;
    rdfs:comment "Chemin exact inputs.nom ou experiment.nom."@fr .

ws:hasColumn a rdf:Property ;
    rdfs:comment "Colonne d'une table calculée."@fr .

ws:hasParameter a rdf:Property ;
    rdfs:comment "Relie un scénario à ses enregistrements de paramètres."@fr ;
    rdfs:domain ws:Scenario ;
    rdfs:range ws:Parameter .

ws:implementationReference a rdf:Property ;
    rdfs:comment "Fonction du backend où le paramètre est utilisé."@fr .

ws:maximum a rdf:Property ;
    rdfs:comment "Borne maximale incluse."@fr .

ws:maximumExclusive a rdf:Property ;
    rdfs:comment "Borne maximale exclue."@fr .

ws:meaning a rdf:Property ;
    rdfs:comment "Sens scientifique et limites de la quantité."@fr .

ws:minimum a rdf:Property ;
    rdfs:comment "Borne minimale incluse."@fr .

ws:minimumExclusive a rdf:Property ;
    rdfs:comment "Borne minimale exclue."@fr .

ws:modelComponent a rdf:Property ;
    rdfs:comment "Composante du modèle à laquelle appartient le paramètre."@fr .

ws:operationalDefault a rdf:Property ;
    rdfs:comment "Réglage technique préautorisé par la politique utilisateur, sans hypothèse physique nouvelle."@fr .

ws:origin a rdf:Property ;
    rdfs:comment "Origine : provided, default, assumption ou missing."@fr .

ws:quantity a rdf:Property ;
    rdfs:comment "Nature de la quantité : énergie, puissance, indice, identifiant, etc."@fr .

ws:repository a rdf:Property ;
    rdfs:comment "Dépôt source du logiciel."@fr .

ws:request a rdf:Property ;
    rdfs:comment "Demande ayant produit la configuration."@fr .

ws:requiresIndicator a rdf:Property ;
    rdfs:comment "Indicateur associé à l'intention."@fr .

ws:revision a rdf:Property ;
    rdfs:comment "Révision du logiciel effectivement exécuté."@fr .

ws:task a rdf:Property ;
    rdfs:comment "Tâche déclarée du scénario."@fr .

<https://github.com/cyrilvoyant/websemantic/ns#tls/accident_probability_per_day> a skos:Concept ;
    skos:altLabel "probabilité d’accident"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Probabilité journalière de tirer un événement synthétique d’accident ; TLS tire ensuite son début et sa durée."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.accident_probability_per_day" ;
    skos:prefLabel "Probabilité d'accident"@fr ;
    skos:scopeNote "Ce n’est pas une fréquence d’accident par véhicule ni une statistique directement déduite de BAAC."@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 1.5e-02 ;
    ws:fieldPath "inputs.accident_probability_per_day" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:maximum 1 ;
    ws:minimum 0 ;
    ws:modelComponent "stochastic" ;
    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"probabilité d’accident courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 0.015}, \"faible\": {\"aliases\": [\"faible probabilité d’accident\", \"accidents rares\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 0.00375}, \"très élevé\": {\"aliases\": [\"très forte probabilité d’accident\", \"accidents très fréquents\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte probabilité d’accident\", \"accidents fréquents\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 0.2}"^^rdf:JSON ;
    ws:quantity "daily_event_probability" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/accident_sensitivity> a skos:Concept ;
    skos:altLabel "sensibilité aux accidents"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Coefficient de surcroît de ventilation lorsqu’un accident est actif ; il s’ajoute au coefficient de pollution dans le même facteur."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.accident_sensitivity" ;
    skos:prefLabel "Sensibilité accidents"@fr ;
    skos:scopeNote "Ce paramètre ne représente ni la gravité ni le coût énergétique complet d’un accident réel."@fr ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 7.5e-01 ;
    ws:fieldPath "inputs.accident_sensitivity" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "ventilation" ;
    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"sensibilité aux accidents courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 0.75}, \"faible\": {\"aliases\": [\"faible sensibilité aux accidents\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 0.1875}, \"très élevé\": {\"aliases\": [\"très forte sensibilité aux accidents\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte sensibilité aux accidents\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 2.0}"^^rdf:JSON ;
    ws:quantity "dimensionless_coefficient" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/altitude_m> a skos:Concept ;
    skos:altLabel "altitude du tunnel"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Altitude utilisée dans le facteur de ventilation : 1 + max(altitude_m − 500, 0)/6000."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.altitude_m" ;
    skos:prefLabel "Altitude"@fr ;
    skos:scopeNote "Le référentiel altimétrique n’est pas déclaré par le modèle ; l’altitude de la commune ne fixe pas celle du tunnel."@fr ;
    ws:canonicalUnitToken "unit:M" ;
    ws:dataType "float" ;
    ws:defaultValue 300 ;
    ws:fieldPath "inputs.altitude_m" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "ventilation" ;
    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"altitude courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 300}, \"faible\": {\"aliases\": [\"faible altitude\", \"basse altitude\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 75.0}, \"très élevé\": {\"aliases\": [\"très haute altitude\", \"altitude très élevée\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"haute altitude\", \"altitude élevée\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 3000.0}"^^rdf:JSON ;
    ws:quantity "length" ;
    ws:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    ws:unitSymbol "m" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/annual_energy> a ws:Intent ;
    skos:related <https://github.com/cyrilvoyant/websemantic/ns#tls/annualized_mwh> ;
    ws:requiresIndicator <https://github.com/cyrilvoyant/websemantic/ns#tls/annualized_mwh> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/aux_kw_per_km_tube> a skos:Concept ;
    skos:altLabel "charge des auxiliaires"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Charge de référence des auxiliaires en kW/(km·tube), multipliée par la longueur, les tubes et le facteur de profondeur."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.aux_kw_per_km_tube" ;
    skos:prefLabel "Auxiliaires"@fr ;
    skos:scopeNote "Ne pas confondre cette charge linéique avec une énergie ; un bruit propre aux auxiliaires est ajouté par TLS."@fr ;
    ws:canonicalUnitToken "unit:KiloW per km per tube" ;
    ws:dataType "float" ;
    ws:defaultValue 3.5e+01 ;
    ws:fieldPath "inputs.aux_kw_per_km_tube" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "auxiliaries" ;
    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"charge auxiliaire courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 35.0}, \"faible\": {\"aliases\": [\"faible charge auxiliaire\", \"auxiliaires peu puissants\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 8.75}, \"très élevé\": {\"aliases\": [\"très forte charge auxiliaire\", \"auxiliaires très puissants\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte charge auxiliaire\", \"auxiliaires puissants\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 120.0}"^^rdf:JSON ;
    ws:quantity "linear_power_per_tube" ;
    ws:unitAlias "kW par km et par tube",
        "kW/(km.tube)",
        "kW/(km·tube)",
        "kW/km/tube" ;
    ws:unitSymbol "kW/(km·tube)" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/base_fixed_kw> a skos:Concept ;
    skos:altLabel "charge fixe"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Puissance fixe ajoutée une seule fois à la demande totale du tunnel, avant le bruit multiplicatif global."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.base_fixed_kw" ;
    skos:prefLabel "Charge fixe"@fr ;
    skos:scopeNote "Cette puissance concerne l’ensemble du tunnel, pas chaque tube."@fr ;
    ws:canonicalUnitToken "unit:KiloW" ;
    ws:dataType "float" ;
    ws:defaultValue 4e+01 ;
    ws:fieldPath "inputs.base_fixed_kw" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "base_load" ;
    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"charge fixe courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 40.0}, \"faible\": {\"aliases\": [\"faible charge fixe\", \"charge fixe faible\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 10.0}, \"très élevé\": {\"aliases\": [\"très forte charge fixe\", \"charge fixe très élevée\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte charge fixe\", \"charge fixe élevée\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 500.0}"^^rdf:JSON ;
    ws:quantity "power" ;
    ws:unitAlias "kW",
        "kilowatt",
        "kilowatts",
        "kw" ;
    ws:unitSymbol "kW" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/comparison> a skos:Concept ;
    skos:definition "Deux exécutions indépendantes après validation complète. CSV réunis avec une colonne scenario valant scenario_1 ou scenario_2 ; aucune moyenne entre scénarios. Conserver les sorties et manifestes individuels. Écarts entre médianes ; pourcentage relatif au scénario 2, indéfini si référence nulle. Graines communes, sans garantie de tirages identiques après modification de configuration."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Comparaison de deux scénarios"@fr ;
    ws:controlledParameter <https://github.com/cyrilvoyant/websemantic/ns#tls/base_seed>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/freq_minutes>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/n_days>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/n_runs>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/start_date> ;
    ws:scenarioCount 2 .

<https://github.com/cyrilvoyant/websemantic/ns#tls/energy_demand> a ws:Intent ;
    skos:related <https://github.com/cyrilvoyant/websemantic/ns#tls/total_mwh> ;
    ws:requiresIndicator <https://github.com/cyrilvoyant/websemantic/ns#tls/total_mwh> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-1> a skos:Concept ;
    skos:definition "R est le profil de pointes et de nuit ; Q98 est sa référence déterministe au 98e percentile, C le contexte, S la saison, W le jour de semaine et D_j un tirage journalier normal de moyenne 1 et écart-type 0,06. Aucun comptage de véhicules."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Trafic"@fr ;
    ws:expression "T(t) = clip((R(t)/Q98) × C × S × W × traffic_level × D_j, 0, 2)" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "sans unité" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-2> a skos:Concept ;
    skos:definition "h, c et w sont en heures ; A est sans unité. R = 0,16 + 0,06 cos(2π(h-3)/24) + G(h;c_m,w,1) + G(h;c_s,1,15w,1,1), plus G(h;18,7;2,5;0,25) en contexte urbain. w est un écart-type temporel."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Pointes"@fr ;
    ws:expression "G(h;c,w,A) = A × exp(-0,5 × ((h-c)/w)^2)" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "sans unité" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-3> a skos:Concept ;
    skos:definition "Altitude et profondeur en m ; pente saisie en %, donc 2 pour 2 %. Le plafond de profondeur concerne le facteur, pas la longueur ni la validité géologique."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Facteurs géométriques"@fr ;
    ws:expression "F_alt = 1 + max(altitude_m-500,0)/6000 ; F_pente = 1 + abs(gradient_percent)/20 ; F_profondeur = 1 + min(max_depth_m,800)/6000" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "sans unité" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-4> a skos:Concept ;
    skos:definition "L = length_m/1000 en km. k_l en kW/(km·voie), f_min et c_l sans unité dépendent de la catégorie. J(t) est le profil synthétique de lumière du jour, sans éphéméride locale ; même une catégorie fixed est modulée."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Éclairage"@fr ;
    ws:expression "P_lumière(t) = k_l × L × N_tubes × N_voies × min(f_min + (1-f_min)(1-J(t)) + c_l T(t), 1)" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "kW" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-5> a skos:Concept ;
    skos:definition "k_v est en kW/(km·tube). I_p et I_a sont des indicateurs 0/1 d’événements synthétiques. Les deux coefficients s’ajoutent si les deux événements sont actifs ; ce n’est pas un modèle de sécurité."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Ventilation"@fr ;
    ws:expression "P_vent(t) = k_v × L × N_tubes × (0,15 + traffic_sensitivity × T(t)) × F_alt × F_pente × (1 + pollution_sensitivity × I_p(t) + accident_sensitivity × I_a(t))" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "kW" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-6> a skos:Concept ;
    skos:definition "Z(t) suit une loi normale de moyenne 1 et d’écart-type 0,025 ; ce tirage reste actif même si noise_sigma vaut zéro."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Auxiliaires"@fr ;
    ws:expression "P_aux(t) = aux_kw_per_km_tube × L × N_tubes × F_profondeur × Z(t)" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "kW" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-7> a skos:Concept ;
    skos:definition "ε suit une loi normale de moyenne zéro et d’écart-type noise_sigma. La graine fixe rend les trajectoires reproductibles, sans supprimer les tirages."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Puissance totale"@fr ;
    ws:expression "P(t) = max((base_fixed_kw + P_lumière(t) + P_vent(t) + P_aux(t)) × (1 + ε(t)), 0)" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "kW" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-8> a skos:Concept ;
    skos:definition "L’énergie journalière somme les pas d’une journée. La puissance quotidienne est la moyenne des puissances. E_ann est une extrapolation de la période simulée ; aucune mesure annuelle terrain."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Énergie et annualisation"@fr ;
    ws:expression "E_pas = P(t) × freq_minutes/60 ; E_MWh = somme(E_pas)/1000 ; E_ann = E_MWh × 365/n_days" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "kWh ; MWh ; MWh/an" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/equation-9> a skos:Concept ;
    skos:definition "p est la probabilité journalière déclarée, pas un taux par véhicule. Pollution : début uniforme de 7 à 18 h, durée de 2 à 8 h. Accident : début de 6,5 à 20 h, durée de 0,5 à 3 h. Un événement peut déborder sur le lendemain."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Événements"@fr ;
    ws:expression "B_j ~ Bernoulli(p) ; I(t) = 1 pendant l’événement si B_j = 1" ;
    ws:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    ws:unitSymbol "probabilité sans unité ; durée en h" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/evening_peak_hour> a skos:Concept ;
    skos:altLabel "pointe du soir"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Heure du centre du pic gaussien du soir, comprise entre 0 inclus et 24 exclu."@fr ;
