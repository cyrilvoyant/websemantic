<https://github.com/cyrilvoyant/websemantic/ns#tls/base_seed> a skos:Concept ;
    skos:altLabel "graine aléatoire"@fr,
        "seed"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> ;
    skos:definition "Identifiant initial du générateur pseudo-aléatoire ; chaque réalisation utilise base_seed + run."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.base_seed" ;
    skos:prefLabel "base_seed",
        "Graine"@fr ;
    skos:scopeNote "Identifiant technique fixe à 42 par autorisation antérieure, modifiable uniquement sur demande explicite chiffrée. Faible, forte, meilleure ou nouvelle graine ne désignent pas une intensité physique ; demander une valeur. Ne pas proposer de graine qualitative."@fr,
        "Valeur fixe 42 selon la politique d’essai, modifiable explicitement ; ce n’est pas un paramètre physique."@fr ;
    ws:boundAuthority "policy" ;
    ws:dataType "int" ;
    ws:defaultAuthorization "Politique de reproductibilité des essais : graine initiale fixe à 42, modifiable sur demande explicite." ;
    ws:defaultValue 42 ;
    ws:fieldPath "experiment.base_seed" ;
    ws:implementationReference "simulator.py:run_monte_carlo" ;
    ws:minimum 0 ;
    ws:modelComponent "operational" ;
    ws:operationalDefault true ;
    ws:quantity "identifier" ;
    ws:unitAlias "",
        "1",
        "None",
        "id",
        "identifiant",
        "identifier",
        "nombre",
        "null",
        "number",
        "sans dimension",
        "sans unité",
        "unit:NUM",
        "unit:UNITLESS" ;
    ws:unitSymbol "identifiant" .

