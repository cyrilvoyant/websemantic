########################################################################
# Definitions of the remaining core terms (FOOPS VOC4), written from their use in descriptors, scenarios and shapes.
########################################################################
wsem:Aggregation rdfs:comment "How an output value summarises its native values: per step, per course, sum, mean, median across realisations or maximum. Fixes which values can be added or compared."@en .
wsem:BoundAuthority rdfs:comment "Origin of a bound: the backend code itself, a profile policy of the contract, or a scientific source. A code bound cannot be relaxed by the contract."@en .
wsem:DataOrigin rdfs:comment "Nature of the data behind a value or output, e.g. synthetic simulation, user statement or measurement. Simulated outputs are never presented as measurements."@en .
wsem:Execution rdfs:comment "Controlled run of a pinned backend on a validated scenario, producing simulation outputs and a manifest."@en .
wsem:Request rdfs:comment "Natural-language request of a user, kept verbatim as the source of the evidence spans that support provided values."@en .
wsem:Scenario rdfs:comment "Machine-readable configuration built from a request: task, parameters with origin and acceptance, and experiment settings. Only a validated scenario is executed."@en .
wsem:SimulationOutput rdfs:comment "Result produced by an execution (series, indicators, flags), linked to its scenario, software revision and qualification."@en .
wsem:UnknownValue rdfs:comment "Parameter whose value is neither given, derived, nor accepted; it blocks execution and leads to a clarification."@en .
wsem:UserValue rdfs:comment "Parameter value stated in the request, or an exact unit conversion of a stated value, supported by evidence from the request."@en .
wsem:Validation rdfs:comment "Activity checking a scenario against the contract before execution: types, units, bounds, complete groups, acceptance and relational shapes."@en .
wsem:accepted rdfs:comment "True when the user explicitly accepted a proposed default or convention; an unaccepted proposal cannot be executed."@en .
wsem:boundValue rdfs:comment "Numerical limit of a bound, in the canonical unit of the parameter."@en .
wsem:conceptDOI rdfs:comment "DOI that resolves to all versions of an archived software or dataset (Zenodo concept DOI)."@en .
wsem:derivationRule rdfs:comment "Documented rule linking a quantity to others (e.g. total dose = dose per fraction x fractions). Documentary; executed checks are the SHACL shapes and the Python gate."@en .
wsem:evidenceText rdfs:comment "Exact span of the request that supports a value; quoted, never paraphrased."@en .
wsem:fieldPath rdfs:comment "Path of the field in the published scenario JSON (e.g. inputs.length_m, courses[k].dose_per_fraction)."@en .
wsem:pinnedRevision rdfs:comment "Exact source revision (commit or tag) of the backend used for execution."@en .
wsem:proposedValue rdfs:comment "Numerical value that a qualitative convention proposes for a parameter, in its canonical unit, pending acceptance."@en .
wsem:rank rdfs:comment "Position of a qualitative term on the shared ordinal scale (1 very low to 5 very high); carries no number by itself."@en .
wsem:repository rdfs:comment "URL of the original source repository of a software."@en .
wsem:requiresAcceptance rdfs:comment "True when a convention may only be proposed and must be accepted by the user before execution."@en .
wsem:sourceNote rdfs:comment "Short statement of the source or rationale of a convention, default or bound."@en .
wsem:validityFlag rdfs:comment "Name of the backend flag that marks an output as invalid or saturated (e.g. Result.oar_total_valid); flagged values are not reported as valid results."@en .
wsem:value rdfs:comment "Value of a parameter in a scenario, expressed in the canonical unit of its definition."@en .
wsem:acceptedBy rdfs:comment "Links a hypothesis to the explicit acceptance that allows its use in execution."@en .
wsem:aggregation rdfs:comment "Links an output variable to the aggregation that defines it."@en .
wsem:appliesTo rdfs:comment "Links a qualifier mapping or clarification policy to the parameter it concerns."@en .
wsem:authority rdfs:comment "Links a bound to its authority (code, profile policy or source)."@en .
wsem:concept rdfs:comment "Links a parameter value in a scenario to the parameter definition that gives its meaning, unit and bounds."@en .
wsem:dataOrigin rdfs:comment "Links a value or output to the nature of its data (simulated, stated, measured)."@en .
wsem:declaresOutput rdfs:comment "Links a contract to an output variable it publishes with quantity, unit and aggregation."@en .
wsem:declaresParameter rdfs:comment "Links a contract to a parameter definition it publishes."@en .
wsem:declaresValidityLimit rdfs:comment "Links a contract to a declared limit of validity or use (e.g. not a medical device)."@en .
wsem:excludesTask rdfs:comment "Links a contract to a task profile it explicitly refuses (e.g. patient treatment decision)."@en .
wsem:followsConvention rdfs:comment "Links a hypothesis to the qualitative convention it applies."@en .
wsem:forTask rdfs:comment "Links a scenario to the supported task profile it instantiates."@en .
wsem:fromRequest rdfs:comment "Links evidence to the request it is quoted from."@en .
wsem:hasBound rdfs:comment "Links a parameter definition to one of its bounds."@en .
wsem:hasContract rdfs:comment "Links a software to its semantic contract."@en .
wsem:hasExperiment rdfs:comment "Links a scenario to its experiment settings (period, step, realisations, seed or solver settings)."@en .
wsem:hasParameter rdfs:comment "Links a scenario to one of its parameter values."@en .
wsem:producesOutput rdfs:comment "Links a task profile to an output variable it produces."@en .
wsem:qualifiedBy rdfs:comment "Links a simulation output to its qualification (quantity, unit, support, origin, limits)."@en .
wsem:supportedBy rdfs:comment "Links a user value to the request evidence that supports it."@en .
wsem:supportsTask rdfs:comment "Links a contract to a task profile it supports."@en .
wsem:term rdfs:comment "Links a qualifier mapping to the qualitative term of the shared scale that it interprets."@en .


# ---- domain extension ----
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wsem: <https://w3id.org/websemantic/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wsem:ComparisonActivity a rdfs:Class ;
    rdfs:subClassOf prov:Activity .

wsem:Hypothesis a rdfs:Class ;
    rdfs:subClassOf wsem:Parameter .

wsem:Intent a rdfs:Class .

wsem:OperationalSetting a rdfs:Class ;
    rdfs:subClassOf wsem:Parameter .

wsem:Parameter a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

wsem:Scenario a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

wsem:SimulationOutput a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

wsem:UserValue a rdfs:Class ;
    rdfs:subClassOf wsem:Parameter .

wsem:accepted a rdf:Property ;
    rdfs:comment "Acceptation explicite de l'hypothèse."@fr ;
    rdfs:domain wsem:Parameter ;
    rdfs:range rdfs:Literal .

wsem:aggregation a rdf:Property ;
    rdfs:comment "Méthode de regroupement de la table calculée."@fr .

wsem:allowedValue a rdf:Property ;
    rdfs:comment "Valeur catégorielle autorisée."@fr .

wsem:boundAuthority a rdf:Property ;
    rdfs:comment "Origine déclarée de la borne ; code ou politique du prototype."@fr .

wsem:canonicalUnitToken a rdf:Property ;
    rdfs:comment "Identifiant d'unité utilisé par le contrôle Python."@fr .

wsem:concept a rdf:Property ;
    rdfs:comment "Relie un enregistrement à la définition du paramètre."@fr ;
    rdfs:domain rdfs:Resource ;
    rdfs:range skos:Concept .

wsem:dataType a rdf:Property ;
    rdfs:comment "Type attendu par le contrôle déterministe."@fr .

wsem:defaultAuthorization a rdf:Property ;
    rdfs:comment "Source de l’autorisation du défaut technique fixe."@fr .

wsem:defaultValue a rdf:Property ;
    rdfs:comment "Proposition du profil ; jamais acceptée automatiquement par le graphe."@fr .

wsem:evidence a rdf:Property ;
    rdfs:comment "Extrait exact de la demande ; présence ne prouve pas la justesse sémantique."@fr .

wsem:fieldPath a rdf:Property ;
    rdfs:comment "Chemin exact inputs.nom ou experiment.nom."@fr .

wsem:hasColumn a rdf:Property ;
    rdfs:comment "Colonne d'une table calculée."@fr .

wsem:hasParameter a rdf:Property ;
    rdfs:comment "Relie un scénario à ses enregistrements de paramètres."@fr ;
    rdfs:domain wsem:Scenario ;
    rdfs:range wsem:Parameter .

wsem:implementationReference a rdf:Property ;
    rdfs:comment "Fonction du backend où le paramètre est utilisé."@fr .

wsem:maximum a rdf:Property ;
    rdfs:comment "Borne maximale incluse."@fr .

wsem:maximumExclusive a rdf:Property ;
    rdfs:comment "Borne maximale exclue."@fr .

wsem:meaning a rdf:Property ;
    rdfs:comment "Sens scientifique et limites de la quantité."@fr .

wsem:minimum a rdf:Property ;
    rdfs:comment "Borne minimale incluse."@fr .

wsem:minimumExclusive a rdf:Property ;
    rdfs:comment "Borne minimale exclue."@fr .

wsem:modelComponent a rdf:Property ;
    rdfs:comment "Composante du modèle à laquelle appartient le paramètre."@fr .

wsem:operationalDefault a rdf:Property ;
    rdfs:comment "Réglage technique préautorisé par la politique utilisateur, sans hypothèse physique nouvelle."@fr .

wsem:origin a rdf:Property ;
    rdfs:comment "Origine : provided, default, assumption ou missing."@fr .

wsem:quantity a rdf:Property ;
    rdfs:comment "Nature de la quantité : énergie, puissance, indice, identifiant, etc."@fr .

wsem:repository a rdf:Property ;
    rdfs:comment "Dépôt source du logiciel."@fr .

wsem:request a rdf:Property ;
    rdfs:comment "Demande ayant produit la configuration."@fr .

wsem:requiresIndicator a rdf:Property ;
    rdfs:comment "Indicateur associé à l'intention."@fr .

wsem:revision a rdf:Property ;
    rdfs:comment "Révision du logiciel effectivement exécuté."@fr .

wsem:task a rdf:Property ;
    rdfs:comment "Tâche déclarée du scénario."@fr .

<https://w3id.org/websemantic/ns#tls/accident_probability_per_day> a skos:Concept ;
    skos:altLabel "probabilité d’accident"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
    skos:definition "Probabilité journalière de tirer un événement synthétique d’accident ; TLS tire ensuite son début et sa durée."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.accident_probability_per_day" ;
    skos:prefLabel "Probabilité d'accident"@fr ;
    skos:scopeNote "Ce n’est pas une fréquence d’accident par véhicule ni une statistique directement déduite de BAAC."@fr ;
    wsem:boundAuthority "code" ;
    wsem:canonicalUnitToken "unit:UNITLESS" ;
    wsem:dataType "float" ;
    wsem:defaultValue 1.5e-02 ;
    wsem:fieldPath "inputs.accident_probability_per_day" ;
    wsem:implementationReference "simulator.py:simulate_one_realization" ;
    wsem:maximum 1 ;
    wsem:minimum 0 ;
    wsem:modelComponent "stochastic" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"probabilité d’accident courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 0.015}, \"faible\": {\"aliases\": [\"faible probabilité d’accident\", \"accidents rares\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 0.00375}, \"très élevé\": {\"aliases\": [\"très forte probabilité d’accident\", \"accidents très fréquents\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte probabilité d’accident\", \"accidents fréquents\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 0.2}"^^rdf:JSON ;
    wsem:quantity "daily_event_probability" ;
    wsem:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    wsem:unitSymbol "1" .

<https://w3id.org/websemantic/ns#tls/accident_sensitivity> a skos:Concept ;
    skos:altLabel "sensibilité aux accidents"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
    skos:definition "Coefficient de surcroît de ventilation lorsqu’un accident est actif ; il s’ajoute au coefficient de pollution dans le même facteur."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.accident_sensitivity" ;
    skos:prefLabel "Sensibilité accidents"@fr ;
    skos:scopeNote "Ce paramètre ne représente ni la gravité ni le coût énergétique complet d’un accident réel."@fr ;
    wsem:canonicalUnitToken "unit:UNITLESS" ;
    wsem:dataType "float" ;
    wsem:defaultValue 7.5e-01 ;
    wsem:fieldPath "inputs.accident_sensitivity" ;
    wsem:implementationReference "simulator.py:simulate_one_realization" ;
    wsem:modelComponent "ventilation" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"sensibilité aux accidents courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 0.75}, \"faible\": {\"aliases\": [\"faible sensibilité aux accidents\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 0.1875}, \"très élevé\": {\"aliases\": [\"très forte sensibilité aux accidents\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte sensibilité aux accidents\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 2.0}"^^rdf:JSON ;
    wsem:quantity "dimensionless_coefficient" ;
    wsem:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    wsem:unitSymbol "1" .

<https://w3id.org/websemantic/ns#tls/altitude_m> a skos:Concept ;
    skos:altLabel "altitude du tunnel"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
    skos:definition "Altitude utilisée dans le facteur de ventilation : 1 + max(altitude_m − 500, 0)/6000."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.altitude_m" ;
    skos:prefLabel "Altitude"@fr ;
    skos:scopeNote "Le référentiel altimétrique n’est pas déclaré par le modèle ; l’altitude de la commune ne fixe pas celle du tunnel."@fr ;
    wsem:canonicalUnitToken "unit:M" ;
    wsem:dataType "float" ;
    wsem:defaultValue 300 ;
    wsem:fieldPath "inputs.altitude_m" ;
    wsem:implementationReference "simulator.py:simulate_one_realization" ;
    wsem:modelComponent "ventilation" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"altitude courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 300}, \"faible\": {\"aliases\": [\"faible altitude\", \"basse altitude\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 75.0}, \"très élevé\": {\"aliases\": [\"très haute altitude\", \"altitude très élevée\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"haute altitude\", \"altitude élevée\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 3000.0}"^^rdf:JSON ;
    wsem:quantity "length" ;
    wsem:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    wsem:unitSymbol "m" .

<https://w3id.org/websemantic/ns#tls/annual_energy> a wsem:Intent ;
    skos:related <https://w3id.org/websemantic/ns#tls/annualized_mwh> ;
    wsem:requiresIndicator <https://w3id.org/websemantic/ns#tls/annualized_mwh> .

<https://w3id.org/websemantic/ns#tls/aux_kw_per_km_tube> a skos:Concept ;
    skos:altLabel "charge des auxiliaires"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
    skos:definition "Charge de référence des auxiliaires en kW/(km·tube), multipliée par la longueur, les tubes et le facteur de profondeur."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.aux_kw_per_km_tube" ;
    skos:prefLabel "Auxiliaires"@fr ;
    skos:scopeNote "Ne pas confondre cette charge linéique avec une énergie ; un bruit propre aux auxiliaires est ajouté par TLS."@fr ;
    wsem:canonicalUnitToken "unit:KiloW per km per tube" ;
    wsem:dataType "float" ;
    wsem:defaultValue 3.5e+01 ;
    wsem:fieldPath "inputs.aux_kw_per_km_tube" ;
    wsem:implementationReference "simulator.py:simulate_one_realization" ;
    wsem:modelComponent "auxiliaries" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"charge auxiliaire courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 35.0}, \"faible\": {\"aliases\": [\"faible charge auxiliaire\", \"auxiliaires peu puissants\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 8.75}, \"très élevé\": {\"aliases\": [\"très forte charge auxiliaire\", \"auxiliaires très puissants\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte charge auxiliaire\", \"auxiliaires puissants\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 120.0}"^^rdf:JSON ;
    wsem:quantity "linear_power_per_tube" ;
    wsem:unitAlias "kW par km et par tube",
        "kW/(km.tube)",
        "kW/(km·tube)",
        "kW/km/tube" ;
    wsem:unitSymbol "kW/(km·tube)" .

<https://w3id.org/websemantic/ns#tls/base_fixed_kw> a skos:Concept ;
    skos:altLabel "charge fixe"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
    skos:definition "Puissance fixe ajoutée une seule fois à la demande totale du tunnel, avant le bruit multiplicatif global."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.base_fixed_kw" ;
    skos:prefLabel "Charge fixe"@fr ;
    skos:scopeNote "Cette puissance concerne l’ensemble du tunnel, pas chaque tube."@fr ;
    wsem:canonicalUnitToken "unit:KiloW" ;
    wsem:dataType "float" ;
    wsem:defaultValue 4e+01 ;
    wsem:fieldPath "inputs.base_fixed_kw" ;
    wsem:implementationReference "simulator.py:simulate_one_realization" ;
    wsem:modelComponent "base_load" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"charge fixe courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 40.0}, \"faible\": {\"aliases\": [\"faible charge fixe\", \"charge fixe faible\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 10.0}, \"très élevé\": {\"aliases\": [\"très forte charge fixe\", \"charge fixe très élevée\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte charge fixe\", \"charge fixe élevée\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 500.0}"^^rdf:JSON ;
    wsem:quantity "power" ;
    wsem:unitAlias "kW",
        "kilowatt",
        "kilowatts",
        "kw" ;
    wsem:unitSymbol "kW" .

<https://w3id.org/websemantic/ns#tls/comparison> a skos:Concept ;
    skos:definition "Deux exécutions indépendantes après validation complète. CSV réunis avec une colonne scenario valant scenario_1 ou scenario_2 ; aucune moyenne entre scénarios. Conserver les sorties et manifestes individuels. Écarts entre médianes ; pourcentage relatif au scénario 2, indéfini si référence nulle. Graines communes, sans garantie de tirages identiques après modification de configuration."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Comparaison de deux scénarios"@fr ;
    wsem:controlledParameter <https://w3id.org/websemantic/ns#tls/base_seed>,
        <https://w3id.org/websemantic/ns#tls/freq_minutes>,
        <https://w3id.org/websemantic/ns#tls/n_days>,
        <https://w3id.org/websemantic/ns#tls/n_runs>,
        <https://w3id.org/websemantic/ns#tls/start_date> ;
    wsem:scenarioCount 2 .

<https://w3id.org/websemantic/ns#tls/energy_demand> a wsem:Intent ;
    skos:related <https://w3id.org/websemantic/ns#tls/total_mwh> ;
    wsem:requiresIndicator <https://w3id.org/websemantic/ns#tls/total_mwh> .

<https://w3id.org/websemantic/ns#tls/equation-1> a skos:Concept ;
    skos:definition "R est le profil de pointes et de nuit ; Q98 est sa référence déterministe au 98e percentile, C le contexte, S la saison, W le jour de semaine et D_j un tirage journalier normal de moyenne 1 et écart-type 0,06. Aucun comptage de véhicules."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Trafic"@fr ;
    wsem:expression "T(t) = clip((R(t)/Q98) × C × S × W × traffic_level × D_j, 0, 2)" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "sans unité" .

<https://w3id.org/websemantic/ns#tls/equation-2> a skos:Concept ;
    skos:definition "h, c et w sont en heures ; A est sans unité. R = 0,16 + 0,06 cos(2π(h-3)/24) + G(h;c_m,w,1) + G(h;c_s,1,15w,1,1), plus G(h;18,7;2,5;0,25) en contexte urbain. w est un écart-type temporel."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Pointes"@fr ;
    wsem:expression "G(h;c,w,A) = A × exp(-0,5 × ((h-c)/w)^2)" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "sans unité" .

<https://w3id.org/websemantic/ns#tls/equation-3> a skos:Concept ;
    skos:definition "Altitude et profondeur en m ; pente saisie en %, donc 2 pour 2 %. Le plafond de profondeur concerne le facteur, pas la longueur ni la validité géologique."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Facteurs géométriques"@fr ;
    wsem:expression "F_alt = 1 + max(altitude_m-500,0)/6000 ; F_pente = 1 + abs(gradient_percent)/20 ; F_profondeur = 1 + min(max_depth_m,800)/6000" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "sans unité" .

<https://w3id.org/websemantic/ns#tls/equation-4> a skos:Concept ;
    skos:definition "L = length_m/1000 en km. k_l en kW/(km·voie), f_min et c_l sans unité dépendent de la catégorie. J(t) est le profil synthétique de lumière du jour, sans éphéméride locale ; même une catégorie fixed est modulée."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Éclairage"@fr ;
    wsem:expression "P_lumière(t) = k_l × L × N_tubes × N_voies × min(f_min + (1-f_min)(1-J(t)) + c_l T(t), 1)" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "kW" .

<https://w3id.org/websemantic/ns#tls/equation-5> a skos:Concept ;
    skos:definition "k_v est en kW/(km·tube). I_p et I_a sont des indicateurs 0/1 d’événements synthétiques. Les deux coefficients s’ajoutent si les deux événements sont actifs ; ce n’est pas un modèle de sécurité."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Ventilation"@fr ;
    wsem:expression "P_vent(t) = k_v × L × N_tubes × (0,15 + traffic_sensitivity × T(t)) × F_alt × F_pente × (1 + pollution_sensitivity × I_p(t) + accident_sensitivity × I_a(t))" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "kW" .

<https://w3id.org/websemantic/ns#tls/equation-6> a skos:Concept ;
    skos:definition "Z(t) suit une loi normale de moyenne 1 et d’écart-type 0,025 ; ce tirage reste actif même si noise_sigma vaut zéro."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Auxiliaires"@fr ;
    wsem:expression "P_aux(t) = aux_kw_per_km_tube × L × N_tubes × F_profondeur × Z(t)" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "kW" .

<https://w3id.org/websemantic/ns#tls/equation-7> a skos:Concept ;
    skos:definition "ε suit une loi normale de moyenne zéro et d’écart-type noise_sigma. La graine fixe rend les trajectoires reproductibles, sans supprimer les tirages."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Puissance totale"@fr ;
    wsem:expression "P(t) = max((base_fixed_kw + P_lumière(t) + P_vent(t) + P_aux(t)) × (1 + ε(t)), 0)" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "kW" .

<https://w3id.org/websemantic/ns#tls/equation-8> a skos:Concept ;
    skos:definition "L’énergie journalière somme les pas d’une journée. La puissance quotidienne est la moyenne des puissances. E_ann est une extrapolation de la période simulée ; aucune mesure annuelle terrain."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Énergie et annualisation"@fr ;
    wsem:expression "E_pas = P(t) × freq_minutes/60 ; E_MWh = somme(E_pas)/1000 ; E_ann = E_MWh × 365/n_days" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "kWh ; MWh ; MWh/an" .

<https://w3id.org/websemantic/ns#tls/equation-9> a skos:Concept ;
    skos:definition "p est la probabilité journalière déclarée, pas un taux par véhicule. Pollution : début uniforme de 7 à 18 h, durée de 2 à 8 h. Accident : début de 6,5 à 20 h, durée de 0,5 à 3 h. Un événement peut déborder sur le lendemain."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "Événements"@fr ;
    wsem:expression "B_j ~ Bernoulli(p) ; I(t) = 1 pendant l’événement si B_j = 1" ;
    wsem:implementationReference "TLS simulator.py:simulate_one_realization / run_monte_carlo, commit 748e053e129669cf3e896d381e3c0ac01c763edd." ;
    wsem:unitSymbol "probabilité sans unité ; durée en h" .

<https://w3id.org/websemantic/ns#tls/evening_peak_hour> a skos:Concept ;
    skos:altLabel "pointe du soir"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
    skos:definition "Heure du centre du pic gaussien du soir, comprise entre 0 inclus et 24 exclu."@fr ;
