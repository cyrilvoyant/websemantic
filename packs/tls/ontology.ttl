<https://w3id.org/websemantic/ns#tls/outputs/daily> a skos:Concept ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "daily" ;
    wsem:aggregation "Agrégation journalière de la réalisation 0 : somme de l'énergie et moyenne de la puissance ; pas une médiane Monte Carlo. Les dates suivent le calendrier sans fuseau déclaré."@fr ;
    wsem:hasColumn <https://w3id.org/websemantic/ns#tls/outputs/daily/energy_kwh>,
        <https://w3id.org/websemantic/ns#tls/outputs/daily/mean_kw>,
        <https://w3id.org/websemantic/ns#tls/outputs/daily/timestamp> .

<https://w3id.org/websemantic/ns#tls/peak_kw> a skos:Concept ;
    skos:prefLabel "peak_kw" .

<https://w3id.org/websemantic/ns#tls/specific_kwh_m_year> a skos:Concept ;
    skos:prefLabel "specific_kwh_m_year" .

<https://w3id.org/websemantic/ns#tls/timestamp> a skos:Concept ;
    skos:prefLabel "timestamp" .

<https://w3id.org/websemantic/ns#tls/total_mwh> a skos:Concept ;
    skos:prefLabel "total_mwh" .

<https://w3id.org/websemantic/ns#tls/outputs/season_profiles> a skos:Concept ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "season_profiles" ;
    wsem:aggregation "Puissance moyenne par saison et heure du jour, dans chaque réalisation, uniquement sur les jours simulés."@fr ;
    wsem:hasColumn <https://w3id.org/websemantic/ns#tls/outputs/season_profiles/hour_int>,
        <https://w3id.org/websemantic/ns#tls/outputs/season_profiles/power_kw>,
        <https://w3id.org/websemantic/ns#tls/outputs/season_profiles/run>,
        <https://w3id.org/websemantic/ns#tls/outputs/season_profiles/season> .

<https://w3id.org/websemantic/ns#tls/outputs/envelope> a skos:Concept ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "envelope" ;
    wsem:aggregation "Puissances moyennées par heure dans chaque réalisation, puis statistiques entre réalisations. p10/p90 sont des quantiles empiriques, pas un intervalle de confiance."@fr ;
    wsem:hasColumn <https://w3id.org/websemantic/ns#tls/outputs/envelope/mean>,
        <https://w3id.org/websemantic/ns#tls/outputs/envelope/median>,
        <https://w3id.org/websemantic/ns#tls/outputs/envelope/p10>,
        <https://w3id.org/websemantic/ns#tls/outputs/envelope/p90>,
        <https://w3id.org/websemantic/ns#tls/outputs/envelope/timestamp> .

