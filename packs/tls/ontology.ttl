ws:declaresParameter rdfs:label "declares parameter"@en .
ws:declaresValidityLimit rdfs:label "declares validity limit"@en .
ws:dependsOnReference rdfs:label "depends on reference"@en .
ws:derivationRule rdfs:label "derivation rule"@en .
ws:derivedFrom rdfs:label "derived from"@en .
ws:derivedFromOutput rdfs:label "derived from output"@en .
ws:evidenceText rdfs:label "evidence text"@en .
ws:excludesTask rdfs:label "excludes task"@en .
ws:fieldPath rdfs:label "field path"@en .
ws:followsConvention rdfs:label "follows convention"@en .
ws:forTask rdfs:label "for task"@en .
ws:fromRequest rdfs:label "from request"@en .
ws:groupInstance rdfs:label "group instance"@en .
