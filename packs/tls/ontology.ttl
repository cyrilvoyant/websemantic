<https://w3id.org/websemantic/ns#tls/outputs/kpis> a skos:Concept ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "kpis" ;
    wsem:aggregation "Une ligne par réalisation sur toute la période simulée."@fr ;
    wsem:hasColumn <https://w3id.org/websemantic/ns#tls/outputs/kpis/annualized_mwh>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/base_seed>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/load_factor>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/mean_kw>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/n_accident_events>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/n_pollution_events>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/peak_kw>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/run>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/seed>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/specific_kwh_m_year>,
        <https://w3id.org/websemantic/ns#tls/outputs/kpis/total_mwh> .

