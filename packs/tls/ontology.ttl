    wsem:dataType "float" ;
    wsem:defaultValue 2e+00 ;
    wsem:fieldPath "inputs.gradient_percent" ;
    wsem:implementationReference "simulator.py:simulate_one_realization" ;
    wsem:modelComponent "ventilation" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"pente courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 2.0}, \"faible\": {\"aliases\": [\"faible pente\", \"pente faible\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 0.5}, \"très élevé\": {\"aliases\": [\"très forte pente\", \"pente très forte\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte pente\", \"pente forte\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 12.0}"^^rdf:JSON ;
    wsem:quantity "percentage" ;
    wsem:unitAlias "%",
        "percent",
        "pourcent",
        "pourcentage" ;
    wsem:unitSymbol "%" .

<https://w3id.org/websemantic/ns#tls/length_efficiency> a wsem:Intent ;
