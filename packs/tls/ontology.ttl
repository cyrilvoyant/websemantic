<https://w3id.org/websemantic/ns#tls/n_days> a skos:Concept ;
    skos:altLabel "durée de simulation"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/experiment> ;
    skos:definition "Nombre de jours entiers simulés à partir de start_date."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.n_days" ;
    skos:prefLabel "Durée"@fr ;
    skos:scopeNote "L’annualisation utilise 365/n_days ; 365 jours ne couvrent pas une année civile bissextile complète."@fr ;
    wsem:boundAuthority "policy" ;
    wsem:canonicalUnitToken "unit:DAY" ;
    wsem:dataType "int" ;
    wsem:defaultValue 7 ;
    wsem:fieldPath "experiment.n_days" ;
    wsem:implementationReference "simulator.py:run_monte_carlo" ;
    wsem:minimum 1 ;
    wsem:modelComponent "experiment" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Durées conventionnelles en jours : 1, 7, 365 et 1095. Les calculs longs peuvent être plus coûteux ; ces durées ne garantissent pas une couverture calendaire complète.\", \"levels\": {\"courant\": {\"aliases\": [\"durée de simulation courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 7}, \"court\": {\"aliases\": [\"courte période de simulation\", \"simulation courte\"], \"answer_aliases\": [\"court\"], \"value\": 1}, \"long\": {\"aliases\": [\"longue période de simulation\", \"simulation longue\"], \"answer_aliases\": [\"long\"], \"value\": 365}, \"très long\": {\"aliases\": [\"très longue période de simulation\", \"simulation très longue\"], \"answer_aliases\": [\"très long\"], \"value\": 1095}}}"^^rdf:JSON ;
    wsem:quantity "duration_days" ;
    wsem:unitAlias "day",
        "days",
        "j",
        "jour",
        "jours" ;
    wsem:unitSymbol "jours" .

<https://w3id.org/websemantic/ns#tls/n_pollution_events> a skos:Concept ;
    skos:prefLabel "n_pollution_events" .

<https://w3id.org/websemantic/ns#tls/n_runs> a skos:Concept ;
    skos:altLabel "nombre de réalisations"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/experiment> ;
    skos:definition "Nombre de réalisations Monte Carlo indépendantes ; chaque réalisation utilise base_seed + son indice."@fr ;
    skos:inScheme <https://w3id.org/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.n_runs" ;
    skos:prefLabel "Réalisations"@fr ;
    skos:scopeNote "Augmenter ce nombre décrit mieux la variabilité du modèle, sans ajouter une validation terrain."@fr ;
    wsem:boundAuthority "policy" ;
    wsem:canonicalUnitToken "unit:NUM" ;
    wsem:dataType "int" ;
    wsem:defaultValue 3 ;
    wsem:fieldPath "experiment.n_runs" ;
    wsem:implementationReference "simulator.py:run_monte_carlo" ;
    wsem:minimum 1 ;
    wsem:modelComponent "experiment" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Comptages Monte Carlo conventionnels, à valider ; beaucoup = 30 et énormément = 50 selon une échelle entière. Plus de réalisations augmente le coût ; cela ne valide pas le modèle.\", \"levels\": {\"beaucoup\": {\"aliases\": [\"beaucoup de réalisations\"], \"answer_aliases\": [\"beaucoup\"], \"value\": 30}, \"courant\": {\"aliases\": [\"nombre courant de réalisations\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 3}, \"maximum de référence\": {\"aliases\": [\"énormément de réalisations\"], \"answer_aliases\": [\"énormément\"], \"value\": 50}, \"peu\": {\"aliases\": [\"peu de réalisations\"], \"answer_aliases\": [\"peu\"], \"value\": 1}}}"^^rdf:JSON ;
    wsem:quantity "count" ;
    wsem:unitAlias "1",
        "count",
        "nombre",
        "number",
        "realisations",
        "réalisations",
        "tubes",
        "unit:UNITLESS",
        "voies" ;
    wsem:unitSymbol "nombre" .

