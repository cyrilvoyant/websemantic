<https://github.com/cyrilvoyant/websemantic/ns#tls/start_date> a skos:Concept ;
    skos:altLabel "date de début"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> ;
    skos:definition "Date de début au format YYYY-MM-DD ; détermine le calendrier, les jours de semaine et les saisons du modèle."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.start_date" ;
    skos:prefLabel "Début"@fr ;
    skos:scopeNote "Demander une date ou une référence temporelle explicite. « Tôt », « tard » et « début d’année » sans année ne déterminent pas une date. Ne pas choisir silencieusement la date du jour. Le défaut est une proposition acceptée seulement sur accord."@fr,
        "Pas de fuseau déclaré ; le profil de lumière saisonnier est celui du modèle, pas une éphéméride du site."@fr ;
    ws:dataType "date" ;
    ws:defaultValue "2025-01-01" ;
    ws:fieldPath "experiment.start_date" ;
    ws:implementationReference "simulator.py:run_monte_carlo" ;
    ws:modelComponent "experiment" ;
    ws:quantity "calendar_date" ;
    ws:unitAlias "",
        "1",
        "ISO8601",
        "None",
        "YYYY-MM-DD",
        "date",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    ws:unitSymbol "date" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/traffic_index> a skos:Concept ;
    skos:prefLabel "traffic_index" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/ventilation_kw> a skos:Concept ;
