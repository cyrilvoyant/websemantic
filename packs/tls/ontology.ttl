    skos:prefLabel "Pointe du soir"@fr ;
    skos:scopeNote "Heure du calendrier simulé ; aucun fuseau horaire ni changement d’heure n’est modélisé."@fr ;
    wsem:canonicalUnitToken "unit:HR" ;
    wsem:dataType "float" ;
    wsem:defaultValue 1.8e+01 ;
    wsem:fieldPath "inputs.evening_peak_hour" ;
    wsem:implementationReference "simulator.py:simulate_one_realization" ;
    wsem:modelComponent "traffic" ;
    wsem:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Centre de la pointe en heures du jour, proposé à valider ; ce n’est pas une durée ni un horaire local observé.\", \"levels\": {\"courant\": {\"aliases\": [\"pointe du soir courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 18}, \"tard\": {\"aliases\": [\"pointe du soir tardive\", \"pic du soir tardif\"], \"answer_aliases\": [\"tard\"], \"value\": 22}, \"tôt\": {\"aliases\": [\"pointe du soir tôt\", \"pic du soir précoce\"], \"answer_aliases\": [\"tôt\"], \"value\": 15}}}"^^rdf:JSON ;
    wsem:quantity "time_of_day" ;
    wsem:unitAlias "h",
        "h du jour",
        "heure",
        "heures",
        "hour",
        "hours" ;
    wsem:unitSymbol "h du jour" .

<https://w3id.org/websemantic/ns#tls/gradient_percent> a skos:Concept ;
    skos:altLabel "pente du tunnel"@fr ;
    skos:broader <https://w3id.org/websemantic/ns#tls/group/inputs> ;
    skos:definition "Pente en pourcentage, utilisée dans le facteur de ventilation 1 + abs(gradient_percent)/20."@fr ;
