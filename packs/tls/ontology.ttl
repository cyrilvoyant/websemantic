<https://github.com/cyrilvoyant/websemantic/ns#tls/annualized_mwh> a skos:Concept ;
    skos:prefLabel "annualized_mwh" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/daily> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "daily" ;
    ws:aggregation "Agrégation journalière de la réalisation 0 : somme de l'énergie et moyenne de la puissance ; pas une médiane Monte Carlo. Les dates suivent le calendrier sans fuseau déclaré."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/daily/energy_kwh>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/daily/mean_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/daily/timestamp> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/peak_kw> a skos:Concept ;
    skos:prefLabel "peak_kw" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/specific_kwh_m_year> a skos:Concept ;
    skos:prefLabel "specific_kwh_m_year" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/timestamp> a skos:Concept ;
    skos:prefLabel "timestamp" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/total_mwh> a skos:Concept ;
    skos:prefLabel "total_mwh" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "season_profiles" ;
    ws:aggregation "Puissance moyenne par saison et heure du jour, dans chaque réalisation, uniquement sur les jours simulés."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/hour_int>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/power_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/run>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/season> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "envelope" ;
    ws:aggregation "Puissances moyennées par heure dans chaque réalisation, puis statistiques entre réalisations. p10/p90 sont des quantiles empiriques, pas un intervalle de confiance."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/mean>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/median>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/p10>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/p90>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/timestamp> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> a skos:Concept ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "experiment" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> a skos:Concept ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "outputs" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "kpis" ;
    ws:aggregation "Une ligne par réalisation sur toute la période simulée."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/annualized_mwh>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/base_seed>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/load_factor>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/mean_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/n_accident_events>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/n_pollution_events>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/peak_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/run>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/seed>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/specific_kwh_m_year>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis/total_mwh> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "representative" ;
    ws:aggregation "Réalisation 0 au pas natif ; exemple de trajectoire, pas la médiane."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/accident_event>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/auxiliary_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/day_type>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/dayofweek>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/energy_kwh>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/hour_int>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/lighting_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/pollution_event>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/power_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/season>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/timestamp>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/traffic_index>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/representative/ventilation_kw> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> a skos:Concept ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "inputs" .

<https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> a skos:ConceptScheme ;
    skos:hasTopConcept <https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:prefLabel "Tunnel Load Simulator" .

