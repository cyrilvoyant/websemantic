<https://github.com/cyrilvoyant/websemantic/ns#tls/gradient_percent> a skos:Concept ;
    skos:altLabel "pente du tunnel"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Pente en pourcentage, utilisée dans le facteur de ventilation 1 + abs(gradient_percent)/20."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.gradient_percent" ;
    skos:prefLabel "Pente"@fr ;
    skos:scopeNote "Une pente de 2 % se saisit 2, pas 0,02 ; l’adaptateur courant demande une valeur non négative."@fr ;
    ws:canonicalUnitToken "unit:PERCENT" ;
    ws:dataType "float" ;
    ws:defaultValue 2e+00 ;
    ws:fieldPath "inputs.gradient_percent" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "ventilation" ;
    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"pente courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 2.0}, \"faible\": {\"aliases\": [\"faible pente\", \"pente faible\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 0.5}, \"très élevé\": {\"aliases\": [\"très forte pente\", \"pente très forte\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte pente\", \"pente forte\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 12.0}"^^rdf:JSON ;
    ws:quantity "percentage" ;
    ws:unitAlias "%",
        "percent",
        "pourcent",
        "pourcentage" ;
    ws:unitSymbol "%" .

