    ws:aggregation "Agrégation journalière de la réalisation 0 : somme de l'énergie et moyenne de la puissance ; pas une médiane Monte Carlo. Les dates suivent le calendrier sans fuseau déclaré."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/daily/energy_kwh>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/daily/mean_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/daily/timestamp> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/peak_kw> a skos:Concept ;
    skos:prefLabel "peak_kw" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/specific_kwh_m_year> a skos:Concept ;
    skos:prefLabel "specific_kwh_m_year" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/timestamp> a skos:Concept ;
    skos:prefLabel "timestamp" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/total_mwh> a skos:Concept ;
    skos:prefLabel "total_mwh" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "season_profiles" ;
    ws:aggregation "Puissance moyenne par saison et heure du jour, dans chaque réalisation, uniquement sur les jours simulés."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/hour_int>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/power_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/run>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/season_profiles/season> .

ws:QualitativeScale a skos:ConceptScheme ;
    skos:prefLabel "Shared qualitative scale"@en,
        "Échelle qualitative commune"@fr .

ws:TLS_traffic_level a ws:ParameterDefinition ;
    skos:definition "Multiplier of the reference traffic profile; not vehicles per day."@en ;
    skos:prefLabel "Relative traffic"@en,
        "Trafic relatif"@fr ;
    ws:apiVariable "TunnelConfig.traffic_level" ;
    ws:canonicalUnit unit:UNITLESS ;
    ws:fieldPath "inputs.traffic_level" ;
    ws:quantityKind qk:Dimensionless .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "envelope" ;
    ws:aggregation "Puissances moyennées par heure dans chaque réalisation, puis statistiques entre réalisations. p10/p90 sont des quantiles empiriques, pas un intervalle de confiance."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/mean>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/median>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/p10>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/p90>,
        <https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/envelope/timestamp> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> a skos:Concept ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "experiment" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> a skos:Concept ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "outputs" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/outputs/kpis> a skos:Concept ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/outputs> ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:prefLabel "kpis" ;
