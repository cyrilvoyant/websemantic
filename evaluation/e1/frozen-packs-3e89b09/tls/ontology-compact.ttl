    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Valeur de scénario proposée, à valider. Le niveau courant reprend le défaut déclaré ; élevé et très élevé utilisent 75 % et 100 % de la référence haute du curseur. Ces niveaux ne sont pas des statistiques observées.\", \"levels\": {\"courant\": {\"aliases\": [\"probabilité de pollution courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 0.05}, \"faible\": {\"aliases\": [\"faible probabilité de pollution\", \"événements de pollution rares\"], \"answer_aliases\": [\"faible\", \"peu\"], \"value\": 0.0125}, \"très élevé\": {\"aliases\": [\"très forte probabilité de pollution\", \"événements de pollution très fréquents\"], \"answer_aliases\": [\"très élevé\", \"très fort\"], \"fraction\": 1.0}, \"élevé\": {\"aliases\": [\"forte probabilité de pollution\", \"événements de pollution fréquents\"], \"answer_aliases\": [\"élevé\", \"fort\"], \"fraction\": 0.75}}, \"reference_upper\": 0.5}"^^rdf:JSON ;
    ws:quantity "daily_event_probability" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

