<https://github.com/cyrilvoyant/websemantic/ns#tls/freq_minutes> a skos:Concept ;
    skos:altLabel "pas interne"@fr,
        "pas temporel"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> ;
    skos:definition "Durée constante du pas interne ; l’énergie du pas vaut puissance × freq_minutes/60."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.freq_minutes" ;
    skos:prefLabel "Pas de calcul"@fr ;
    skos:scopeNote "Pas admis : 5, 10, 15, 30 ou 60 min. Une sortie quotidienne est une agrégation, pas un calcul à minuit."@fr ;
    ws:boundAuthority "policy" ;
    ws:canonicalUnitToken "unit:MIN" ;
    ws:dataType "int" ;
    ws:defaultValue 60 ;
    ws:fieldPath "experiment.freq_minutes" ;
    ws:implementationReference "simulator.py:run_monte_carlo" ;
    ws:minimum 1 ;
    ws:modelComponent "experiment" ;
    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Pas internes admis par TLS, en minutes. Un pas plus fin est plus petit. Une sortie journalière est une agrégation et ne fixe pas ce pas interne.\", \"levels\": {\"fin\": {\"aliases\": [\"pas fin\", \"résolution temporelle fine\"], \"answer_aliases\": [\"fin\"], \"value\": 10}, \"grossier\": {\"aliases\": [\"pas grossier\", \"résolution temporelle grossière\"], \"answer_aliases\": [\"grossier\"], \"value\": 60}, \"intermédiaire\": {\"aliases\": [\"pas intermédiaire\"], \"answer_aliases\": [\"intermédiaire\"], \"value\": 15}, \"large\": {\"aliases\": [\"pas large\"], \"answer_aliases\": [\"large\"], \"value\": 30}, \"très fin\": {\"aliases\": [\"pas très fin\", \"résolution temporelle très fine\"], \"answer_aliases\": [\"très fin\"], \"value\": 5}}}"^^rdf:JSON ;
    ws:quantity "duration_minutes" ;
    ws:unitAlias "min",
        "minute",
        "minutes" ;
    ws:unitSymbol "min" .

