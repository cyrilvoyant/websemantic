    ws:qualitativeScale "{\"authority\": \"Convention d’essai WebSemantic ; références de curseurs vérifiées dans TLS app.py @748e053e129669cf3e896d381e3c0ac01c763edd. Ni limite physique ni calibration terrain.\", \"interpretation\": \"Centre de la pointe en heures du jour, proposé à valider ; ce n’est pas une durée ni un horaire local observé.\", \"levels\": {\"courant\": {\"aliases\": [\"pointe du soir courante\"], \"answer_aliases\": [\"courant\", \"habituel\"], \"value\": 18}, \"tard\": {\"aliases\": [\"pointe du soir tardive\", \"pic du soir tardif\"], \"answer_aliases\": [\"tard\"], \"value\": 22}, \"tôt\": {\"aliases\": [\"pointe du soir tôt\", \"pic du soir précoce\"], \"answer_aliases\": [\"tôt\"], \"value\": 15}}}"^^rdf:JSON ;
    ws:quantity "time_of_day" ;
    ws:unitAlias "h",
        "h du jour",
        "heure",
        "heures",
        "hour",
        "hours" ;
