@prefix ws:   <https://github.com/cyrilvoyant/websemantic/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# SHACL shapes executed over a scenario graph merged with the ontology.
# Generic shapes (any domain): numeric type, declared bounds, complete groups;
# they read ws:hasBound and ws:partOfGroup from the graph.
# Domain-specific shapes: LQL total dose (d x n) and pyrcel RH/S0 conversion;
# they name their concepts and encode the rule, they do not execute
# ws:derivationRule strings. Repeated groups (courses, aerosol modes) are
# checked per ws:groupInstance, never across instances.

ws:PrefixDecl a owl:Ontology ;
    sh:declare [ sh:prefix "ws" ; sh:namespace "https://github.com/cyrilvoyant/websemantic/ns#"^^xsd:anyURI ] .

ws:ParameterRecordShape a sh:NodeShape ;
    sh:targetClass ws:Parameter ;
    sh:property [ sh:path ws:concept ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ws:ParameterDefinition ;
                  sh:message "Each record refers to exactly one known parameter definition." ] ;
    sh:property [ sh:path ws:value ; sh:maxCount 1 ;
                  sh:message "A record carries at most one value; competing values are conflicts, not duplicates." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Record of a repeated parameter lacks ws:groupInstance (course or mode identifier)." ;
        sh:prefixes ws:PrefixDecl ;
        sh:select """
            SELECT $this WHERE {
              $this ws:concept ?c . ?c ws:requiresInstance true .
              FILTER NOT EXISTS { $this ws:groupInstance ?k }
            }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Numeric value expected for a parameter with a canonical unit." ;
        sh:prefixes ws:PrefixDecl ;
        sh:select """
            SELECT $this ?value WHERE {
              $this ws:value ?value ; ws:concept ?c . ?c ws:canonicalUnit ?u .
              FILTER ( !isNumeric(?value) )
            }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Value violates a declared bound ({?kind} {?bound})." ;
        sh:prefixes ws:PrefixDecl ;
        sh:select """
            SELECT $this ?value ?kind ?bound WHERE {
              $this ws:value ?value ; ws:concept ?c .
              ?c ws:hasBound ?b . ?b ws:boundKind ?kind ; ws:boundValue ?bound .
              FILTER ( (?kind = "min" && ?value < ?bound) || (?kind = "max" && ?value > ?bound) ||
                       (?kind = "min_exclusive" && ?value <= ?bound) || (?kind = "max_exclusive" && ?value >= ?bound) )
            }""" ] .

ws:DerivedQuantityShape a sh:NodeShape ;
    sh:targetClass ws:Scenario ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Stated total dose of a course disagrees with its dose per fraction x number of fractions (conflict to resolve)." ;
        sh:prefixes ws:PrefixDecl ;
        sh:select """
            SELECT $this WHERE {
              $this ws:hasParameter ?t, ?d, ?n .
              ?t ws:concept ws:LQL_total_dose ; ws:value ?tv ; ws:groupInstance ?k .
              ?d ws:concept ws:LQL_dose_per_fraction ; ws:value ?dv ; ws:groupInstance ?k .
              ?n ws:concept ws:LQL_n_fractions ; ws:value ?nv ; ws:groupInstance ?k .
              FILTER ( ABS(?tv - ?dv * ?nv) > 1e-9 )
            }""" ] .

ws:SameQuantityShape a sh:NodeShape ;
    sh:targetClass ws:Scenario ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Relative humidity and initial supersaturation describe one state and disagree (S0 must equal RH_fraction - 1)." ;
        sh:prefixes ws:PrefixDecl ;
        sh:select """
            SELECT $this WHERE {
              $this ws:hasParameter ?h, ?s .
              ?h ws:concept ws:PYR_RH ; ws:value ?rh .
              ?s ws:concept ws:PYR_S0 ; ws:value ?s0 .
              ws:PYR_RH ws:convertibleTo ws:PYR_S0 .
              FILTER ( ABS(?s0 - (?rh - 1.0)) > 1e-9 )
            }""" ] .

ws:CompleteGroupShape a sh:NodeShape ;
    sh:targetClass ws:Scenario ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Incomplete parameter group ({?group}, instance {?k}): all members must be supplied together." ;
        sh:prefixes ws:PrefixDecl ;
        sh:select """
            SELECT DISTINCT $this ?group ?k WHERE {
              $this ws:hasParameter ?r . ?r ws:concept ?c ; ws:groupInstance ?k . ?c ws:partOfGroup ?group .
              ?m ws:partOfGroup ?group .
              FILTER NOT EXISTS { $this ws:hasParameter ?r2 . ?r2 ws:concept ?m ; ws:groupInstance ?k }
            }""" ] .
