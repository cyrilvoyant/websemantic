  "tasks": {
    "supported": [
      "estimate electricity demand (energy, peak, load factor) of a road tunnel under stated assumptions",
      "compare configurations (lighting, ventilation, traffic) with controlled seeds",
      "characterise stochastic variability from modelled events"
    ],
    "excluded": [
      "certify design values or predict consumption of a real tunnel without calibration",
      "infer traffic in vehicles per day"
    ]
  },
  "nature": "synthetic, first-order Monte Carlo generator; not calibrated against measured tunnels",
  "uncertainty": {
    "covered": [
      "multiplicative noise",
      "daily traffic variability",
      "pollution and accident events"
    ],
    "not_covered": [
      "parameter uncertainty",
      "structural model error",
      "calibration error"
    ]
  },
  "validity_notes": [
    "short-period annualisation (365/n_days) differs from seasonally complete simulation",
    "engineering constants are placeholders to calibrate against measured data"
  ],
  "output_tables": {
    "representative": {
      "file": "representative.csv",
      "aggregation": "Réalisation 0 au pas natif ; exemple de trajectoire, pas la médiane.",
      "columns": {
        "timestamp": {
          "quantity": "time",
          "unit": "ISO 8601",
          "meaning": "Horodatage sans fuseau horaire déclaré ; aucune localisation déduite."
        },
        "season": {
          "quantity": "category",
          "unit": null,
          "meaning": "Saison du calendrier simulé ; ne prouve pas une couverture annuelle."
        },
        "hour_int": {
          "quantity": "hour_of_day",
          "unit": "h",
          "meaning": "Heure du jour, de 0 à 23 ; pas une durée."
        },
        "dayofweek": {
          "quantity": "weekday_index",
          "unit": "1",
          "meaning": "Indice : lundi 0, dimanche 6."
        },
        "day_type": {
