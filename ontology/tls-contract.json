          "unit": "1",
          "meaning": "Indicateur binaire d'accident simulé."
        },
        "lighting_kw": {
          "quantity": "power",
          "unit": "kW",
          "meaning": "Puissance électrique calculée."
        },
        "ventilation_kw": {
          "quantity": "power",
          "unit": "kW",
          "meaning": "Puissance électrique calculée."
        },
        "auxiliary_kw": {
          "quantity": "power",
          "unit": "kW",
          "meaning": "Puissance électrique calculée."
        },
        "power_kw": {
          "quantity": "power",
          "unit": "kW",
          "meaning": "Puissance électrique calculée."
        },
        "energy_kwh": {
          "quantity": "energy",
          "unit": "kWh",
          "meaning": "Énergie du pas : power_kw × freq_minutes / 60."
        }
      }
    },
    "kpis": {
      "file": "kpis.csv",
      "aggregation": "Une ligne par réalisation sur toute la période simulée.",
      "columns": {
        "run": {
          "quantity": "identifier",
          "unit": null,
          "meaning": "Identifiant de réalisation Monte Carlo, à partir de 0."
        },
        "seed": {
          "quantity": "identifier",
          "unit": null,
          "meaning": "Graine pseudo-aléatoire : base_seed + run."
        },
        "total_mwh": {
          "quantity": "energy",
          "unit": "MWh",
          "meaning": "Énergie de toute la période : somme des energy_kwh / 1000."
        },
        "annualized_mwh": {
          "quantity": "annualized_energy",
          "unit": "MWh/an",
          "meaning": "Extrapolation : total_mwh × 365 / n_days ; pas une année observée."
        },
        "peak_kw": {
          "quantity": "power",
          "unit": "kW",
          "meaning": "Puissance électrique calculée."
        },
        "mean_kw": {
          "quantity": "power",
          "unit": "kW",
          "meaning": "Puissance électrique calculée."
        },
        "load_factor": {
          "quantity": "power_ratio",
          "unit": "1",
          "meaning": "mean_kw / peak_kw par réalisation ; sans dimension, 0,6 équivaut à 60 %."
        },
        "specific_kwh_m_year": {
          "quantity": "length_normalized_annualized_energy",
          "unit": "kWh/(m·an)",
          "meaning": "annualized_mwh × 1000 / length_m ; ensemble des tubes, par mètre de longueur du tunnel, pas par mètre-tube."
        },
        "n_pollution_events": {
          "quantity": "transition_count",
          "unit": "1",
          "meaning": "Nombre de transitions 0 vers 1 dans la série pollution_event ; un événement actif au premier pas n'est pas compté."
        },
        "n_accident_events": {
          "quantity": "transition_count",
          "unit": "1",
          "meaning": "Nombre de transitions 0 vers 1 dans la série accident_event ; un événement actif au premier pas n'est pas compté."
        }
      }
    },
    "envelope": {
      "file": "envelope.csv",
