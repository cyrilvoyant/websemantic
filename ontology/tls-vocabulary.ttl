@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ws: <https://github.com/cyrilvoyant/websemantic/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ws:Hypothesis a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:Intent a rdfs:Class .

ws:OperationalSetting a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:Parameter a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

ws:Scenario a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

ws:SimulationOutput a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

ws:UserValue a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:accepted a rdf:Property ;
    rdfs:comment "Acceptation explicite de l'hypothèse."@fr ;
    rdfs:domain ws:Parameter ;
    rdfs:range rdfs:Literal .

ws:aggregation a rdf:Property ;
    rdfs:comment "Méthode de regroupement de la table calculée."@fr .

ws:allowedValue a rdf:Property ;
    rdfs:comment "Valeur catégorielle autorisée."@fr .

ws:boundAuthority a rdf:Property ;
    rdfs:comment "Origine déclarée de la borne ; code ou politique du prototype."@fr .

ws:canonicalUnitToken a rdf:Property ;
    rdfs:comment "Identifiant d'unité utilisé par le contrôle Python."@fr .

ws:concept a rdf:Property ;
    rdfs:comment "Relie un enregistrement à la définition du paramètre."@fr ;
    rdfs:domain rdfs:Resource ;
    rdfs:range skos:Concept .

ws:dataType a rdf:Property ;
    rdfs:comment "Type attendu par le contrôle déterministe."@fr .

ws:defaultAuthorization a rdf:Property ;
    rdfs:comment "Source de l’autorisation du défaut technique fixe."@fr .

ws:defaultValue a rdf:Property ;
    rdfs:comment "Proposition du profil ; jamais acceptée automatiquement par le graphe."@fr .

ws:evidence a rdf:Property ;
    rdfs:comment "Extrait exact de la demande ; présence ne prouve pas la justesse sémantique."@fr .

ws:fieldPath a rdf:Property ;
    rdfs:comment "Chemin exact inputs.nom ou experiment.nom."@fr .

ws:hasColumn a rdf:Property ;
    rdfs:comment "Colonne d'une table calculée."@fr .

ws:hasParameter a rdf:Property ;
    rdfs:comment "Relie un scénario à ses enregistrements de paramètres."@fr ;
    rdfs:domain ws:Scenario ;
    rdfs:range ws:Parameter .

ws:implementationReference a rdf:Property ;
    rdfs:comment "Fonction du backend où le paramètre est utilisé."@fr .

ws:maximum a rdf:Property ;
    rdfs:comment "Borne maximale incluse."@fr .

ws:maximumExclusive a rdf:Property ;
    rdfs:comment "Borne maximale exclue."@fr .

ws:meaning a rdf:Property ;
    rdfs:comment "Sens scientifique et limites de la quantité."@fr .

ws:minimum a rdf:Property ;
    rdfs:comment "Borne minimale incluse."@fr .

ws:minimumExclusive a rdf:Property ;
    rdfs:comment "Borne minimale exclue."@fr .

ws:modelComponent a rdf:Property ;
    rdfs:comment "Composante du modèle à laquelle appartient le paramètre."@fr .

ws:operationalDefault a rdf:Property ;
    rdfs:comment "Réglage technique préautorisé par la politique utilisateur, sans hypothèse physique nouvelle."@fr .

ws:origin a rdf:Property ;
    rdfs:comment "Origine : provided, default, assumption ou missing."@fr .

ws:quantity a rdf:Property ;
    rdfs:comment "Nature de la quantité : énergie, puissance, indice, identifiant, etc."@fr .

ws:repository a rdf:Property ;
    rdfs:comment "Dépôt source du logiciel."@fr .

ws:request a rdf:Property ;
    rdfs:comment "Demande ayant produit la configuration."@fr .

ws:requiresIndicator a rdf:Property ;
    rdfs:comment "Indicateur associé à l'intention."@fr .

ws:revision a rdf:Property ;
    rdfs:comment "Révision du logiciel effectivement exécuté."@fr .

ws:task a rdf:Property ;
    rdfs:comment "Tâche déclarée du scénario."@fr .

<https://github.com/cyrilvoyant/websemantic/ns#tls/accident_probability_per_day> a skos:Concept ;
    skos:altLabel "probabilité d’accident"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Probabilité journalière de tirer un événement synthétique d’accident ; TLS tire ensuite son début et sa durée."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.accident_probability_per_day" ;
    skos:prefLabel "Probabilité d'accident"@fr ;
    skos:scopeNote "Ce n’est pas une fréquence d’accident par véhicule ni une statistique directement déduite de BAAC."@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 1.5e-02 ;
    ws:fieldPath "inputs.accident_probability_per_day" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:maximum 1 ;
    ws:minimum 0 ;
    ws:modelComponent "stochastic" ;
    ws:quantity "daily_event_probability" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/accident_sensitivity> a skos:Concept ;
    skos:altLabel "sensibilité aux accidents"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Coefficient de surcroît de ventilation lorsqu’un accident est actif ; il s’ajoute au coefficient de pollution dans le même facteur."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.accident_sensitivity" ;
    skos:prefLabel "Sensibilité accidents"@fr ;
    skos:scopeNote "Ce paramètre ne représente ni la gravité ni le coût énergétique complet d’un accident réel."@fr ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 7.5e-01 ;
    ws:fieldPath "inputs.accident_sensitivity" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "ventilation" ;
    ws:quantity "dimensionless_coefficient" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/altitude_m> a skos:Concept ;
    skos:altLabel "altitude du tunnel"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Altitude utilisée dans le facteur de ventilation : 1 + max(altitude_m − 500, 0)/6000."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.altitude_m" ;
    skos:prefLabel "Altitude"@fr ;
    skos:scopeNote "Le référentiel altimétrique n’est pas déclaré par le modèle ; l’altitude de la commune ne fixe pas celle du tunnel."@fr ;
    ws:canonicalUnitToken "unit:M" ;
    ws:dataType "float" ;
    ws:defaultValue 300 ;
    ws:fieldPath "inputs.altitude_m" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "ventilation" ;
    ws:quantity "length" ;
    ws:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    ws:unitSymbol "m" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/annual_energy> a ws:Intent ;
    skos:related <https://github.com/cyrilvoyant/websemantic/ns#tls/annualized_mwh> ;
    ws:requiresIndicator <https://github.com/cyrilvoyant/websemantic/ns#tls/annualized_mwh> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/aux_kw_per_km_tube> a skos:Concept ;
    skos:altLabel "charge des auxiliaires"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Charge de référence des auxiliaires en kW/(km·tube), multipliée par la longueur, les tubes et le facteur de profondeur."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.aux_kw_per_km_tube" ;
    skos:prefLabel "Auxiliaires"@fr ;
    skos:scopeNote "Ne pas confondre cette charge linéique avec une énergie ; un bruit propre aux auxiliaires est ajouté par TLS."@fr ;
    ws:canonicalUnitToken "unit:KiloW per km per tube" ;
    ws:dataType "float" ;
    ws:defaultValue 3.5e+01 ;
    ws:fieldPath "inputs.aux_kw_per_km_tube" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "auxiliaries" ;
    ws:quantity "linear_power_per_tube" ;
    ws:unitAlias "kW par km et par tube",
        "kW/(km.tube)",
        "kW/(km·tube)",
        "kW/km/tube" ;
    ws:unitSymbol "kW/(km·tube)" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/base_fixed_kw> a skos:Concept ;
    skos:altLabel "charge fixe"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Puissance fixe ajoutée une seule fois à la demande totale du tunnel, avant le bruit multiplicatif global."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.base_fixed_kw" ;
    skos:prefLabel "Charge fixe"@fr ;
    skos:scopeNote "Cette puissance concerne l’ensemble du tunnel, pas chaque tube."@fr ;
    ws:canonicalUnitToken "unit:KiloW" ;
    ws:dataType "float" ;
    ws:defaultValue 4e+01 ;
    ws:fieldPath "inputs.base_fixed_kw" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "base_load" ;
    ws:quantity "power" ;
    ws:unitAlias "kW",
        "kilowatt",
        "kilowatts",
        "kw" ;
    ws:unitSymbol "kW" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/energy_demand> a ws:Intent ;
    skos:related <https://github.com/cyrilvoyant/websemantic/ns#tls/total_mwh> ;
    ws:requiresIndicator <https://github.com/cyrilvoyant/websemantic/ns#tls/total_mwh> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/evening_peak_hour> a skos:Concept ;
    skos:altLabel "pointe du soir"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Heure du centre du pic gaussien du soir, comprise entre 0 inclus et 24 exclu."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.evening_peak_hour" ;
    skos:prefLabel "Pointe du soir"@fr ;
    skos:scopeNote "Heure du calendrier simulé ; aucun fuseau horaire ni changement d’heure n’est modélisé."@fr ;
    ws:canonicalUnitToken "unit:HR" ;
    ws:dataType "float" ;
    ws:defaultValue 1.8e+01 ;
    ws:fieldPath "inputs.evening_peak_hour" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "traffic" ;
    ws:quantity "time_of_day" ;
    ws:unitAlias "h",
        "h du jour",
        "heure",
        "heures",
        "hour",
        "hours" ;
    ws:unitSymbol "h du jour" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/freq_minutes> a skos:Concept ;
    skos:altLabel "pas interne"@fr,
        "pas temporel"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> ;
    skos:definition "Durée constante du pas interne ; l’énergie du pas vaut puissance × freq_minutes/60."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.freq_minutes" ;
    skos:prefLabel "Pas de calcul"@fr ;
    skos:scopeNote "Pas admis : 5, 10, 15, 30 ou 60 min. Une sortie quotidienne est une agrégation, pas un calcul à minuit."@fr ;
    ws:boundAuthority "policy" ;
    ws:canonicalUnitToken "unit:MIN" ;
    ws:dataType "int" ;
    ws:defaultValue 60 ;
    ws:fieldPath "experiment.freq_minutes" ;
    ws:implementationReference "simulator.py:run_monte_carlo" ;
    ws:minimum 1 ;
    ws:modelComponent "experiment" ;
    ws:quantity "duration_minutes" ;
    ws:unitAlias "min",
        "minute",
        "minutes" ;
    ws:unitSymbol "min" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/gradient_percent> a skos:Concept ;
    skos:altLabel "pente du tunnel"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Pente en pourcentage, utilisée dans le facteur de ventilation 1 + abs(gradient_percent)/20."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.gradient_percent" ;
    skos:prefLabel "Pente"@fr ;
    skos:scopeNote "Une pente de 2 % se saisit 2, pas 0,02 ; l’adaptateur courant demande une valeur non négative."@fr ;
    ws:canonicalUnitToken "unit:PERCENT" ;
    ws:dataType "float" ;
    ws:defaultValue 2e+00 ;
    ws:fieldPath "inputs.gradient_percent" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "ventilation" ;
    ws:quantity "percentage" ;
    ws:unitAlias "%",
        "percent",
        "pourcent",
        "pourcentage" ;
    ws:unitSymbol "%" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/length_efficiency> a ws:Intent ;
    skos:related <https://github.com/cyrilvoyant/websemantic/ns#tls/specific_kwh_m_year> ;
    ws:requiresIndicator <https://github.com/cyrilvoyant/websemantic/ns#tls/specific_kwh_m_year> .

<https://github.com/cyrilvoyant/websemantic/ns#tls/length_m> a skos:Concept ;
    skos:altLabel "longueur du tunnel"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Longueur du tunnel commune aux tubes ; convertie en kilomètres pour les charges proportionnelles à la longueur."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.length_m" ;
    skos:prefLabel "Longueur"@fr ;
    skos:scopeNote "Ne pas multiplier la longueur par le nombre de tubes ; ce facteur est appliqué séparément."@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:M" ;
    ws:dataType "float" ;
    ws:defaultValue 1500 ;
    ws:fieldPath "inputs.length_m" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:minimumExclusive 0 ;
    ws:modelComponent "geometry" ;
    ws:quantity "length" ;
    ws:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    ws:unitSymbol "m" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/lighting_type> a skos:Concept ;
    skos:altLabel "type d’éclairage"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Catégorie déterminant la puissance spécifique installée, le couplage au trafic et la fraction minimale d’éclairage."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.lighting_type" ;
    skos:prefLabel "Éclairage"@fr ;
    skos:scopeNote "Même les catégories fixed ont une modulation horaire dans ce modèle ; aucun éclairement en lux n’est calculé."@fr ;
    ws:allowedValue "LED adaptive",
        "LED fixed",
        "mixed",
        "sodium fixed" ;
    ws:dataType "category" ;
    ws:defaultValue "LED adaptive" ;
    ws:fieldPath "inputs.lighting_type" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "lighting" ;
    ws:quantity "category" ;
    ws:unitAlias "",
        "1",
        "None",
        "categorical",
        "categorie",
        "category",
        "catégorie",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    ws:unitSymbol "catégorie" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/max_depth_m> a skos:Concept ;
    skos:altLabel "profondeur maximale"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Profondeur maximale utilisée pour les auxiliaires : facteur 1 + min(max_depth_m, 800)/6000."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.max_depth_m" ;
    skos:prefLabel "Couverture maximale"@fr ;
    skos:scopeNote "Le plafonnement de l’effet à 800 m n’est pas une limite géométrique de validité physique."@fr ;
    ws:canonicalUnitToken "unit:M" ;
    ws:dataType "float" ;
    ws:defaultValue 80 ;
    ws:fieldPath "inputs.max_depth_m" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "auxiliaries" ;
    ws:quantity "length" ;
    ws:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    ws:unitSymbol "m" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/morning_peak_hour> a skos:Concept ;
    skos:altLabel "pointe du matin"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Heure du centre du pic gaussien du matin, comprise entre 0 inclus et 24 exclu."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.morning_peak_hour" ;
    skos:prefLabel "Pointe du matin"@fr ;
    skos:scopeNote "Heure du calendrier simulé ; aucun fuseau horaire ni changement d’heure n’est modélisé."@fr ;
    ws:canonicalUnitToken "unit:HR" ;
    ws:dataType "float" ;
    ws:defaultValue 8e+00 ;
    ws:fieldPath "inputs.morning_peak_hour" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "traffic" ;
    ws:quantity "time_of_day" ;
    ws:unitAlias "h",
        "h du jour",
        "heure",
        "heures",
        "hour",
        "hours" ;
    ws:unitSymbol "h du jour" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/n_days> a skos:Concept ;
    skos:altLabel "durée de simulation"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> ;
    skos:definition "Nombre de jours entiers simulés à partir de start_date."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.n_days" ;
    skos:prefLabel "Durée"@fr ;
    skos:scopeNote "L’annualisation utilise 365/n_days ; 365 jours ne couvrent pas une année civile bissextile complète."@fr ;
    ws:boundAuthority "policy" ;
    ws:canonicalUnitToken "unit:DAY" ;
    ws:dataType "int" ;
    ws:defaultValue 7 ;
    ws:fieldPath "experiment.n_days" ;
    ws:implementationReference "simulator.py:run_monte_carlo" ;
    ws:minimum 1 ;
    ws:modelComponent "experiment" ;
    ws:quantity "duration_days" ;
    ws:unitAlias "day",
        "days",
        "j",
        "jour",
        "jours" ;
    ws:unitSymbol "jours" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/n_lanes_per_tube> a skos:Concept ;
    skos:altLabel "nombre de voies par tube"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Nombre de voies dans chaque tube ; l’éclairage est dimensionné sur n_tubes × n_lanes_per_tube."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.n_lanes_per_tube" ;
    skos:prefLabel "Voies par tube"@fr ;
    skos:scopeNote "Ne pas fournir le nombre total de voies à la place du nombre par tube."@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:NUM" ;
    ws:dataType "int" ;
    ws:defaultValue 2 ;
    ws:fieldPath "inputs.n_lanes_per_tube" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:maximum 6 ;
    ws:minimum 1 ;
    ws:modelComponent "geometry" ;
    ws:quantity "count" ;
    ws:unitAlias "1",
        "count",
        "nombre",
        "number",
        "realisations",
        "réalisations",
        "tubes",
        "unit:UNITLESS",
        "voies" ;
    ws:unitSymbol "nombre" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/n_runs> a skos:Concept ;
    skos:altLabel "nombre de réalisations"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/experiment> ;
    skos:definition "Nombre de réalisations Monte Carlo indépendantes ; chaque réalisation utilise base_seed + son indice."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "experiment.n_runs" ;
    skos:prefLabel "Réalisations"@fr ;
    skos:scopeNote "Augmenter ce nombre décrit mieux la variabilité du modèle, sans ajouter une validation terrain."@fr ;
    ws:boundAuthority "policy" ;
    ws:canonicalUnitToken "unit:NUM" ;
    ws:dataType "int" ;
    ws:defaultValue 3 ;
    ws:fieldPath "experiment.n_runs" ;
    ws:implementationReference "simulator.py:run_monte_carlo" ;
    ws:minimum 1 ;
    ws:modelComponent "experiment" ;
    ws:quantity "count" ;
    ws:unitAlias "1",
        "count",
        "nombre",
        "number",
        "realisations",
        "réalisations",
        "tubes",
        "unit:UNITLESS",
        "voies" ;
    ws:unitSymbol "nombre" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/n_tubes> a skos:Concept ;
    skos:altLabel "nombre de tubes"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Nombre de tubes ; multiplie les charges de ventilation et d’auxiliaires et contribue au nombre total de voies."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.n_tubes" ;
    skos:prefLabel "Tubes"@fr ;
