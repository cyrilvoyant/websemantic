        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    ws:unitSymbol "date" .

<https://github.com/cyrilvoyant/websemantic/ns#tls/traffic_level> a skos:Concept ;
    skos:altLabel "niveau de trafic"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
    skos:definition "Multiplicateur du profil synthétique de trafic normalisé ; l’indice final est borné entre 0 et 2 dans TLS."@fr ;
    skos:inScheme <https://github.com/cyrilvoyant/websemantic/ns#vocabulary/c21cfff2027903a8> ;
    skos:notation "inputs.traffic_level" ;
    skos:prefLabel "Trafic relatif"@fr ;
