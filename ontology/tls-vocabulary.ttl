<https://github.com/cyrilvoyant/websemantic/ns#tls/pollution_sensitivity> a skos:Concept ;
    skos:altLabel "sensibilité à la pollution"@fr ;
    skos:broader <https://github.com/cyrilvoyant/websemantic/ns#tls/group/inputs> ;
