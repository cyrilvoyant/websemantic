    ws:dataType "float" ;
    ws:defaultValue 5.5e-01 ;
    ws:fieldPath "inputs.pollution_sensitivity" ;
    ws:implementationReference "simulator.py:simulate_one_realization" ;
    ws:modelComponent "ventilation" ;
    ws:quantity "dimensionless_coefficient" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

