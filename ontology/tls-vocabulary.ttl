@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ws: <https://github.com/cyrilvoyant/websemantic/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ws:Hypothesis a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:Intent a rdfs:Class .

ws:Parameter a rdfs:Class .

ws:Scenario a rdfs:Class .

ws:SimulationOutput a rdfs:Class .

ws:UserValue a rdfs:Class ;
    rdfs:subClassOf ws:Parameter .

ws:accepted a rdf:Property ;
    rdfs:comment "Acceptation explicite de l'hypothèse."@fr .

ws:accident_probability_per_day a skos:Concept ;
    skos:definition "Probabilité par jour ; 0,015 = 1,5 %."@fr ;
    skos:prefLabel "Probabilité d'accident"@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 1.5e-02 ;
    ws:fieldPath "inputs.accident_probability_per_day" ;
    ws:maximum 1 ;
    ws:minimum 0 ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

ws:accident_sensitivity a skos:Concept ;
    skos:definition "Coefficient de surcroît lié aux accidents simulés."@fr ;
    skos:prefLabel "Sensibilité accidents"@fr ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 7.5e-01 ;
    ws:fieldPath "inputs.accident_sensitivity" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

ws:aggregation a rdf:Property ;
    rdfs:comment "Méthode de regroupement de la table calculée."@fr .

ws:allowedValue a rdf:Property ;
    rdfs:comment "Valeur catégorielle autorisée."@fr .

ws:altitude_m a skos:Concept ;
    skos:definition "Altitude du tunnel ; une ville ne fixe pas celle du site."@fr ;
    skos:prefLabel "Altitude"@fr ;
    ws:canonicalUnitToken "unit:M" ;
    ws:dataType "float" ;
    ws:defaultValue 300 ;
    ws:fieldPath "inputs.altitude_m" ;
    ws:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    ws:unitSymbol "m" .

ws:annual_energy a ws:Intent ;
    ws:requiresIndicator ws:annualized_mwh .

ws:aux_kw_per_km_tube a skos:Concept ;
    skos:definition "Puissance auxiliaire par kilomètre et par tube."@fr ;
    skos:prefLabel "Auxiliaires"@fr ;
    ws:canonicalUnitToken "unit:KiloW per km per tube" ;
    ws:dataType "float" ;
    ws:defaultValue 3.5e+01 ;
    ws:fieldPath "inputs.aux_kw_per_km_tube" ;
    ws:unitAlias "kW par km et par tube",
        "kW/(km.tube)",
        "kW/(km·tube)",
        "kW/km/tube" ;
    ws:unitSymbol "kW/(km·tube)" .

ws:base_fixed_kw a skos:Concept ;
    skos:definition "Puissance constante ajoutée pour l'ensemble du tunnel."@fr ;
    skos:prefLabel "Charge fixe"@fr ;
    ws:canonicalUnitToken "unit:KiloW" ;
    ws:dataType "float" ;
    ws:defaultValue 4e+01 ;
    ws:fieldPath "inputs.base_fixed_kw" ;
    ws:unitAlias "kW",
        "kilowatt",
        "kilowatts",
        "kw" ;
    ws:unitSymbol "kW" .

ws:base_seed a skos:Concept ;
    skos:definition "Graine pseudo-aléatoire pour reproduire le calcul."@fr ;
    skos:prefLabel "Graine"@fr ;
    ws:boundAuthority "policy" ;
    ws:dataType "int" ;
    ws:defaultValue 42 ;
    ws:fieldPath "experiment.base_seed" ;
    ws:minimum 0 ;
    ws:unitAlias "",
        "1",
        "None",
        "id",
        "identifiant",
        "identifier",
        "nombre",
        "null",
        "number",
        "sans dimension",
        "sans unité",
        "unit:NUM",
        "unit:UNITLESS" ;
    ws:unitSymbol "identifiant" .

ws:boundAuthority a rdf:Property ;
    rdfs:comment "Origine déclarée de la borne ; code ou politique du prototype."@fr .

ws:canonicalUnitToken a rdf:Property ;
    rdfs:comment "Identifiant d'unité utilisé par le contrôle Python."@fr .

ws:concept a rdf:Property ;
    rdfs:comment "Relie un enregistrement à la définition du paramètre."@fr .

ws:dataType a rdf:Property ;
    rdfs:comment "Type attendu par le contrôle déterministe."@fr .

ws:defaultValue a rdf:Property ;
    rdfs:comment "Proposition du profil ; jamais acceptée automatiquement par le graphe."@fr .

ws:energy_demand a ws:Intent ;
    ws:requiresIndicator ws:total_mwh .

ws:evening_peak_hour a skos:Concept ;
    skos:definition "Heure centrale du pic de trafic, entre 0 et 24."@fr ;
    skos:prefLabel "Pointe du soir"@fr ;
    ws:canonicalUnitToken "unit:HR" ;
    ws:dataType "float" ;
    ws:defaultValue 1.8e+01 ;
    ws:fieldPath "inputs.evening_peak_hour" ;
    ws:unitAlias "h",
        "h du jour",
        "heure",
        "heures",
        "hour",
        "hours" ;
    ws:unitSymbol "h du jour" .

ws:evidence a rdf:Property ;
    rdfs:comment "Extrait exact de la demande ; présence ne prouve pas la justesse sémantique."@fr .

ws:fieldPath a rdf:Property ;
    rdfs:comment "Chemin exact inputs.nom ou experiment.nom."@fr .

ws:freq_minutes a skos:Concept ;
    skos:definition "Durée entre deux points de calcul."@fr ;
    skos:prefLabel "Pas de calcul"@fr ;
    ws:boundAuthority "policy" ;
    ws:canonicalUnitToken "unit:MIN" ;
    ws:dataType "int" ;
    ws:defaultValue 60 ;
    ws:fieldPath "experiment.freq_minutes" ;
    ws:minimum 1 ;
    ws:unitAlias "min",
        "minute",
        "minutes" ;
    ws:unitSymbol "min" .

ws:gradient_percent a skos:Concept ;
    skos:definition "Pente longitudinale : 2 % correspond à 2 m par 100 m."@fr ;
    skos:prefLabel "Pente"@fr ;
    ws:canonicalUnitToken "unit:PERCENT" ;
    ws:dataType "float" ;
    ws:defaultValue 2e+00 ;
    ws:fieldPath "inputs.gradient_percent" ;
    ws:unitAlias "%",
        "percent",
        "pourcent",
        "pourcentage" ;
    ws:unitSymbol "%" .

ws:hasColumn a rdf:Property ;
    rdfs:comment "Colonne d'une table calculée."@fr .

ws:hasParameter a rdf:Property ;
    rdfs:comment "Relie un scénario à ses enregistrements de paramètres."@fr .

ws:length_efficiency a ws:Intent ;
    ws:requiresIndicator ws:specific_kwh_m_year .

ws:length_m a skos:Concept ;
    skos:definition "Longueur du tunnel, commune aux tubes."@fr ;
    skos:prefLabel "Longueur"@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:M" ;
    ws:dataType "float" ;
    ws:defaultValue 1500 ;
    ws:fieldPath "inputs.length_m" ;
    ws:minimumExclusive 0 ;
    ws:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    ws:unitSymbol "m" .

ws:lighting_type a skos:Concept ;
    skos:definition "Technologie et commande, pas une intensité lumineuse en lux."@fr ;
    skos:prefLabel "Éclairage"@fr ;
    ws:allowedValue "LED adaptive",
        "LED fixed",
        "mixed",
        "sodium fixed" ;
    ws:dataType "category" ;
    ws:defaultValue "LED adaptive" ;
    ws:fieldPath "inputs.lighting_type" ;
    ws:unitAlias "",
        "1",
        "None",
        "categorical",
        "categorie",
        "category",
        "catégorie",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    ws:unitSymbol "catégorie" .

ws:max_depth_m a skos:Concept ;
    skos:definition "Épaisseur maximale au-dessus du tunnel dans TLS."@fr ;
    skos:prefLabel "Couverture maximale"@fr ;
    ws:canonicalUnitToken "unit:M" ;
    ws:dataType "float" ;
    ws:defaultValue 80 ;
    ws:fieldPath "inputs.max_depth_m" ;
    ws:unitAlias "m",
        "metre",
        "metres",
        "mètre",
        "mètres" ;
    ws:unitSymbol "m" .

ws:maximum a rdf:Property ;
    rdfs:comment "Borne maximale incluse."@fr .

ws:maximumExclusive a rdf:Property ;
    rdfs:comment "Borne maximale exclue."@fr .

ws:meaning a rdf:Property ;
    rdfs:comment "Sens scientifique et limites de la quantité."@fr .

ws:minimum a rdf:Property ;
    rdfs:comment "Borne minimale incluse."@fr .

ws:minimumExclusive a rdf:Property ;
    rdfs:comment "Borne minimale exclue."@fr .

ws:morning_peak_hour a skos:Concept ;
    skos:definition "Heure centrale du pic de trafic, entre 0 et 24."@fr ;
    skos:prefLabel "Pointe du matin"@fr ;
    ws:canonicalUnitToken "unit:HR" ;
    ws:dataType "float" ;
    ws:defaultValue 8e+00 ;
    ws:fieldPath "inputs.morning_peak_hour" ;
    ws:unitAlias "h",
        "h du jour",
        "heure",
        "heures",
        "hour",
        "hours" ;
    ws:unitSymbol "h du jour" .

ws:n_days a skos:Concept ;
    skos:definition "Nombre de jours effectivement simulés."@fr ;
    skos:prefLabel "Durée"@fr ;
    ws:boundAuthority "policy" ;
    ws:canonicalUnitToken "unit:DAY" ;
    ws:dataType "int" ;
    ws:defaultValue 7 ;
    ws:fieldPath "experiment.n_days" ;
    ws:minimum 1 ;
    ws:unitAlias "day",
        "days",
        "j",
        "jour",
        "jours" ;
    ws:unitSymbol "jours" .

ws:n_lanes_per_tube a skos:Concept ;
    skos:definition "Nombre de voies dans chaque tube."@fr ;
    skos:prefLabel "Voies par tube"@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:NUM" ;
    ws:dataType "int" ;
    ws:defaultValue 2 ;
    ws:fieldPath "inputs.n_lanes_per_tube" ;
    ws:maximum 6 ;
    ws:minimum 1 ;
    ws:unitAlias "1",
        "count",
        "nombre",
        "number",
        "realisations",
        "réalisations",
        "tubes",
        "unit:UNITLESS",
        "voies" ;
    ws:unitSymbol "nombre" .

ws:n_runs a skos:Concept ;
    skos:definition "Nombre de trajectoires Monte Carlo."@fr ;
    skos:prefLabel "Réalisations"@fr ;
    ws:boundAuthority "policy" ;
    ws:canonicalUnitToken "unit:NUM" ;
    ws:dataType "int" ;
    ws:defaultValue 3 ;
    ws:fieldPath "experiment.n_runs" ;
    ws:minimum 1 ;
    ws:unitAlias "1",
        "count",
        "nombre",
        "number",
        "realisations",
        "réalisations",
        "tubes",
        "unit:UNITLESS",
        "voies" ;
    ws:unitSymbol "nombre" .

ws:n_tubes a skos:Concept ;
    skos:definition "Nombre de tubes du tunnel."@fr ;
    skos:prefLabel "Tubes"@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:NUM" ;
    ws:dataType "int" ;
    ws:defaultValue 2 ;
    ws:fieldPath "inputs.n_tubes" ;
    ws:maximum 8 ;
    ws:minimum 1 ;
    ws:unitAlias "1",
        "count",
        "nombre",
        "number",
        "realisations",
        "réalisations",
        "tubes",
        "unit:UNITLESS",
        "voies" ;
    ws:unitSymbol "nombre" .

ws:noise_sigma a skos:Concept ;
    skos:definition "Écart-type relatif du bruit ; 0,06 correspond à 6 %."@fr ;
    skos:prefLabel "Bruit multiplicatif"@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 6e-02 ;
    ws:fieldPath "inputs.noise_sigma" ;
    ws:minimum 0 ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

ws:origin a rdf:Property ;
    rdfs:comment "Origine : provided, default, assumption ou missing."@fr .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/daily> a skos:Concept ;
    skos:prefLabel "daily" ;
    ws:aggregation "Agrégation journalière de la réalisation 0 : somme de l'énergie et moyenne de la puissance ; pas une médiane Monte Carlo. Les dates suivent le calendrier sans fuseau déclaré."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#outputs/daily/energy_kwh>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/daily/mean_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/daily/timestamp> .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/envelope> a skos:Concept ;
    skos:prefLabel "envelope" ;
    ws:aggregation "Puissances moyennées par heure dans chaque réalisation, puis statistiques entre réalisations. p10/p90 sont des quantiles empiriques, pas un intervalle de confiance."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#outputs/envelope/mean>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/envelope/median>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/envelope/p10>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/envelope/p90>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/envelope/timestamp> .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis> a skos:Concept ;
    skos:prefLabel "kpis" ;
    ws:aggregation "Une ligne par réalisation sur toute la période simulée."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/annualized_mwh>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/load_factor>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/mean_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/n_accident_events>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/n_pollution_events>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/peak_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/run>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/seed>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/specific_kwh_m_year>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/kpis/total_mwh> .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/representative> a skos:Concept ;
    skos:prefLabel "representative" ;
    ws:aggregation "Réalisation 0 au pas natif ; exemple de trajectoire, pas la médiane."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/accident_event>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/auxiliary_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/day_type>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/dayofweek>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/energy_kwh>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/hour_int>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/lighting_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/pollution_event>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/power_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/season>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/timestamp>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/traffic_index>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/representative/ventilation_kw> .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/season_profiles> a skos:Concept ;
    skos:prefLabel "season_profiles" ;
    ws:aggregation "Puissance moyenne par saison et heure du jour, dans chaque réalisation, uniquement sur les jours simulés."@fr ;
    ws:hasColumn <https://github.com/cyrilvoyant/websemantic/ns#outputs/season_profiles/hour_int>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/season_profiles/power_kw>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/season_profiles/run>,
        <https://github.com/cyrilvoyant/websemantic/ns#outputs/season_profiles/season> .

ws:peak_demand a ws:Intent ;
    ws:requiresIndicator ws:peak_kw .

ws:peak_width_h a skos:Concept ;
    skos:definition "Durée caractéristique des pics de trafic."@fr ;
    skos:prefLabel "Largeur des pics"@fr ;
    ws:canonicalUnitToken "unit:HR" ;
    ws:dataType "float" ;
    ws:defaultValue 1.4e+00 ;
    ws:fieldPath "inputs.peak_width_h" ;
    ws:unitAlias "h",
        "h du jour",
        "heure",
        "heures",
        "hour",
        "hours" ;
    ws:unitSymbol "h" .

ws:pollution_probability_per_day a skos:Concept ;
    skos:definition "Probabilité par jour ; 0,05 = 5 %, pas un taux mesuré."@fr ;
    skos:prefLabel "Probabilité de pollution"@fr ;
    ws:boundAuthority "code" ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 5e-02 ;
    ws:fieldPath "inputs.pollution_probability_per_day" ;
    ws:maximum 1 ;
    ws:minimum 0 ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

ws:pollution_sensitivity a skos:Concept ;
    skos:definition "Coefficient de surcroît lié aux événements de pollution."@fr ;
    skos:prefLabel "Sensibilité pollution"@fr ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 5.5e-01 ;
    ws:fieldPath "inputs.pollution_sensitivity" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

ws:quantity a rdf:Property ;
    rdfs:comment "Nature de la quantité : énergie, puissance, indice, identifiant, etc."@fr .

ws:requiresIndicator a rdf:Property ;
    rdfs:comment "Indicateur associé à l'intention."@fr .

ws:start_date a skos:Concept ;
    skos:definition "Premier jour simulé, au format AAAA-MM-JJ."@fr ;
    skos:prefLabel "Début"@fr ;
    ws:dataType "date" ;
    ws:defaultValue "2025-01-01" ;
    ws:fieldPath "experiment.start_date" ;
    ws:unitAlias "",
        "1",
        "ISO8601",
        "None",
        "YYYY-MM-DD",
        "date",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    ws:unitSymbol "date" .

ws:traffic_level a skos:Concept ;
    skos:definition "Multiplicateur du trafic ; 1 est la référence, pas des véhicules/jour."@fr ;
    skos:prefLabel "Trafic relatif"@fr ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 1e+00 ;
    ws:fieldPath "inputs.traffic_level" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

ws:traffic_sensitivity a skos:Concept ;
    skos:definition "Coefficient du modèle, sans dimension."@fr ;
    skos:prefLabel "Sensibilité au trafic"@fr ;
    ws:canonicalUnitToken "unit:UNITLESS" ;
    ws:dataType "float" ;
    ws:defaultValue 6.5e-01 ;
    ws:fieldPath "inputs.traffic_sensitivity" ;
    ws:unitAlias "1",
        "UNITLESS",
        "dimensionless",
        "sans dimension",
        "unit:NUM" ;
    ws:unitSymbol "1" .

ws:tunnel_context a skos:Concept ;
    skos:definition "Urbain, périurbain ou rural : modifie le modèle de trafic."@fr ;
    skos:prefLabel "Contexte"@fr ;
    ws:allowedValue "peri-urban",
        "rural",
        "urban" ;
    ws:dataType "category" ;
    ws:defaultValue "peri-urban" ;
    ws:fieldPath "inputs.tunnel_context" ;
    ws:unitAlias "",
        "1",
        "None",
        "categorical",
        "categorie",
        "category",
        "catégorie",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    ws:unitSymbol "catégorie" .

ws:unitAlias a rdf:Property ;
    rdfs:comment "Unité reconnue à l'interprétation ; conversion avant validation."@fr .

ws:unitSymbol a rdf:Property ;
    rdfs:comment "Symbole lisible ; ne constitue pas un alignement QUDT vérifié."@fr .

ws:value a rdf:Property ;
    rdfs:comment "Valeur typée dans l'unité canonique déclarée."@fr .

ws:ventilation_type a skos:Concept ;
    skos:definition "Type de ventilation modélisé."@fr ;
    skos:prefLabel "Ventilation"@fr ;
    ws:allowedValue "longitudinal",
        "natural/low ventilation",
        "semi-transverse",
        "transverse" ;
    ws:dataType "category" ;
    ws:defaultValue "longitudinal" ;
    ws:fieldPath "inputs.ventilation_type" ;
    ws:unitAlias "",
        "1",
        "None",
        "categorical",
        "categorie",
        "category",
        "catégorie",
        "null",
        "sans dimension",
        "sans unité",
        "unit:UNITLESS" ;
    ws:unitSymbol "catégorie" .

ws:accident_event a skos:Concept ;
    skos:prefLabel "accident_event" .

ws:auxiliary_kw a skos:Concept ;
    skos:prefLabel "auxiliary_kw" .

ws:day_type a skos:Concept ;
    skos:prefLabel "day_type" .

ws:dayofweek a skos:Concept ;
    skos:prefLabel "dayofweek" .

ws:lighting_kw a skos:Concept ;
    skos:prefLabel "lighting_kw" .

ws:load_factor a skos:Concept ;
    skos:prefLabel "load_factor" .

ws:mean a skos:Concept ;
    skos:prefLabel "mean" .

ws:median a skos:Concept ;
    skos:prefLabel "median" .

ws:n_accident_events a skos:Concept ;
    skos:prefLabel "n_accident_events" .

ws:n_pollution_events a skos:Concept ;
    skos:prefLabel "n_pollution_events" .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/daily/energy_kwh> a skos:Concept ;
    skos:definition "Somme des énergies des pas natifs de la journée, réalisation 0."@fr ;
    ws:concept ws:energy_kwh ;
    ws:quantity "energy" ;
    ws:unitSymbol "kWh" .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/daily/mean_kw> a skos:Concept ;
    skos:definition "Moyenne des puissances des pas natifs de la journée, réalisation 0."@fr ;
    ws:concept ws:mean_kw ;
    ws:quantity "power" ;
    ws:unitSymbol "kW" .

<https://github.com/cyrilvoyant/websemantic/ns#outputs/daily/timestamp> a skos:Concept ;
