ws:LQL_organ_Cauda_equina a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Cauda equina" ; skos:note "organ value of LQL_organ" .
ws:LQL_group_abdomen a skos:Collection ; skos:prefLabel "Abdomen"@fr ; skos:altLabel "abdominal"@fr, "abdomen"@fr ;
    skos:member ws:LQL_organ_Stomach, ws:LQL_organ_Liver, ws:LQL_organ_Kidney, ws:LQL_organ_Small_bowel, ws:LQL_organ_Colon .
ws:LQL_organ_Stomach a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Stomach" ; skos:note "organ value of LQL_organ" .
ws:LQL_organ_Liver a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Liver" ; skos:note "organ value of LQL_organ" .
ws:LQL_organ_Kidney a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Kidney" ; skos:note "organ value of LQL_organ" .
ws:LQL_group_skin a skos:Collection ; skos:prefLabel "Peau"@fr ; skos:altLabel "cutané"@fr, "peau"@fr ;
    skos:member ws:LQL_site_Skin_carcinoma, ws:LQL_site_Skin_melanoma_LQ_L, ws:LQL_organ_Skin_acute, ws:LQL_organ_Skin_late .
ws:LQL_site_Skin_carcinoma a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Skin carcinoma" ; skos:note "tumour_site value of LQL_tumour_site" .
ws:LQL_site_Skin_melanoma_LQ_L a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Skin melanoma (LQ-L)" ; skos:note "tumour_site value of LQL_tumour_site" .
ws:LQL_organ_Skin_acute a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Skin (acute)" ; skos:note "organ value of LQL_organ" .
ws:LQL_organ_Skin_late a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Skin (late)" ; skos:note "organ value of LQL_organ" .
