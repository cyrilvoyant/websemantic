ws:LQL_organ_Retina a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Retina" ; skos:note "organ value of LQL_organ" .
ws:LQL_group_pelvis a skos:Collection ; skos:prefLabel "Pelvis"@fr ; skos:altLabel "pelvien"@fr, "pelvis"@fr, "petit bassin"@fr ;
    skos:member ws:LQL_site_Prostate, ws:LQL_site_Rectum, ws:LQL_site_Cervix_LQ_L, ws:LQL_organ_Rectum, ws:LQL_organ_Bladder, ws:LQL_organ_Femoral_head, ws:LQL_organ_Testis, ws:LQL_organ_Small_bowel, ws:LQL_organ_Colon, ws:LQL_organ_Cauda_equina .
ws:LQL_site_Prostate a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Prostate" ; skos:note "tumour_site value of LQL_tumour_site" .
ws:LQL_site_Rectum a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Rectum" ; skos:note "tumour_site value of LQL_tumour_site" .
ws:LQL_site_Cervix_LQ_L a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Cervix (LQ-L)" ; skos:note "tumour_site value of LQL_tumour_site" .
ws:LQL_organ_Rectum a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Rectum" ; skos:note "organ value of LQL_organ" .
ws:LQL_organ_Bladder a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Bladder" ; skos:note "organ value of LQL_organ" .
ws:LQL_organ_Femoral_head a skos:Concept ; skos:inScheme ws:LQL_AnatomyScheme ; skos:prefLabel "Femoral head" ; skos:note "organ value of LQL_organ" .
