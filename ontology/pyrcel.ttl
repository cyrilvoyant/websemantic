@prefix wsem:   <https://w3id.org/websemantic/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qk:   <http://qudt.org/vocab/quantitykind/> .

# pyrcel extension: instances of the common core only (no new classes).
# Source: docs/pyrcel-contract-definitions.md (draft, scientific review pending).

wsem:TaskParcelActivation
    wsem:requiresParameter wsem:PYR_V, wsem:PYR_T0, wsem:PYR_P0, wsem:PYR_S0,
                         wsem:PYR_N, wsem:PYR_mu, wsem:PYR_sigma, wsem:PYR_kappa ;
    wsem:producesOutput wsem:PYR_S, wsem:PYR_Smax, wsem:PYR_Nd .

wsem:PyrcelContract wsem:declaresParameter wsem:PYR_V, wsem:PYR_T0, wsem:PYR_P0, wsem:PYR_S0, wsem:PYR_RH,
        wsem:PYR_N, wsem:PYR_mu, wsem:PYR_sigma, wsem:PYR_kappa ;
    wsem:declaresOutput wsem:PYR_S, wsem:PYR_Smax, wsem:PYR_Nd, wsem:PYR_T .

wsem:PYR_V a wsem:ParameterDefinition ;
    skos:prefLabel "Vitesse ascendante"@fr ; wsem:apiVariable "ParcelModel(V=)" ; wsem:fieldPath "V" ;
    wsem:quantityKind qk:Velocity ; wsem:canonicalUnit unit:M-PER-SEC ;
    wsem:hasBound [ a wsem:Bound ; wsem:boundKind "min_exclusive" ; wsem:boundValue 0.0 ; wsem:authority wsem:AuthorityPolicy ] .

wsem:PYR_T0 a wsem:ParameterDefinition ;
    skos:prefLabel "Température initiale"@fr ; wsem:apiVariable "ParcelModel(T0=)" ; wsem:fieldPath "T0" ;
    wsem:quantityKind qk:ThermodynamicTemperature ; wsem:canonicalUnit unit:K .

wsem:PYR_P0 a wsem:ParameterDefinition ;
    skos:prefLabel "Pression initiale"@fr ; wsem:apiVariable "ParcelModel(P0=)" ; wsem:fieldPath "P0" ;
    wsem:quantityKind qk:Pressure ; wsem:canonicalUnit unit:PA .

wsem:PYR_S0 a wsem:ParameterDefinition ;
    skos:prefLabel "Sursaturation initiale"@fr ; wsem:apiVariable "ParcelModel(S0=)" ; wsem:fieldPath "S0" ;
    wsem:quantityKind qk:Dimensionless ; wsem:canonicalUnit unit:UNITLESS ;
    wsem:hasBound [ a wsem:Bound ; wsem:boundKind "min_exclusive" ; wsem:boundValue -1.0 ; wsem:authority wsem:AuthorityPolicy ] ,
                [ a wsem:Bound ; wsem:boundKind "max" ; wsem:boundValue 0.0 ; wsem:authority wsem:AuthorityPolicy ] .

wsem:PYR_RH a wsem:ParameterDefinition ;
    skos:prefLabel "Humidité relative initiale"@fr ; wsem:fieldPath "RH (user expression)" ;
    wsem:quantityKind qk:Dimensionless ;
    wsem:convertibleTo wsem:PYR_S0 ;
    wsem:derivationRule "S0 = RH_percent/100 - 1 = RH_fraction - 1; RH and S0 both given and inconsistent is a conflict" .

wsem:PYR_N a wsem:ParameterDefinition ;
    skos:prefLabel "Concentration en nombre du mode"@fr ; wsem:apiVariable "Lognorm(N=)" ; wsem:fieldPath "aerosols[k].N" ;
    wsem:quantityKind qk:NumberDensity ; wsem:canonicalUnit unit:PER-CentiM3 ;
    wsem:partOfGroup "aerosol mode (N, mu, sigma, kappa all required)" ; wsem:requiresInstance true .

wsem:PYR_mu a wsem:ParameterDefinition ;
    skos:prefLabel "Rayon sec médian"@fr ; wsem:apiVariable "Lognorm(mu=)" ; wsem:fieldPath "aerosols[k].mu" ;
    wsem:quantityKind qk:Length ; wsem:canonicalUnit unit:MicroM ;
    wsem:partOfGroup "aerosol mode (N, mu, sigma, kappa all required)" ; wsem:requiresInstance true .

wsem:PYR_sigma a wsem:ParameterDefinition ;
    skos:prefLabel "Écart-type géométrique"@fr ; wsem:apiVariable "Lognorm(sigma=)" ; wsem:fieldPath "aerosols[k].sigma" ;
    wsem:quantityKind qk:Dimensionless ; wsem:canonicalUnit unit:UNITLESS ;
    wsem:partOfGroup "aerosol mode (N, mu, sigma, kappa all required)" ; wsem:requiresInstance true .

wsem:PYR_kappa a wsem:ParameterDefinition ;
    skos:prefLabel "Hygroscopicité κ"@fr ; wsem:apiVariable "AerosolSpecies(kappa=)" ; wsem:fieldPath "aerosols[k].kappa" ;
    wsem:quantityKind qk:Dimensionless ; wsem:canonicalUnit unit:UNITLESS ;
    wsem:partOfGroup "aerosol mode (N, mu, sigma, kappa all required)" ; wsem:requiresInstance true .

wsem:PYR_T a wsem:OutputVariable ;
    skos:prefLabel "Température de la parcelle"@fr ; wsem:apiVariable "to_pandas() T" ;
    wsem:canonicalUnit unit:K ; wsem:aggregation wsem:AggNativeStep ; wsem:additive false ;
    wsem:temporalSupport "nominal output_dt; terminal sample may be irregular" ; wsem:dataOrigin wsem:SyntheticSimulation .

wsem:PYR_S a wsem:OutputVariable ;
    skos:prefLabel "Sursaturation"@fr ; wsem:apiVariable "to_pandas() S" ;
    wsem:canonicalUnit unit:UNITLESS ; wsem:aggregation wsem:AggNativeStep ; wsem:additive false ;
    wsem:temporalSupport "nominal output_dt; terminal sample may be irregular" ; wsem:dataOrigin wsem:SyntheticSimulation .

wsem:PYR_Smax a wsem:OutputVariable ;
    skos:prefLabel "Sursaturation maximale"@fr ; wsem:apiVariable "summary['S_max']" ;
    wsem:canonicalUnit unit:UNITLESS ; wsem:aggregation wsem:AggMax ; wsem:additive false ;
    skos:note "From the peak locator; may differ from the maximum of the sampled S column."@en ;
    wsem:dataOrigin wsem:SyntheticSimulation .

wsem:PYR_Nd a wsem:OutputVariable ;
    skos:prefLabel "Gouttelettes activées"@fr ; wsem:apiVariable "ModelOutput.Nd" ;
    wsem:quantityKind qk:NumberDensity ; wsem:canonicalUnit unit:PER-M3 ;
    skos:note "Returned in m^-3, while input N is in cm^-3."@en ;
    wsem:temporalSupport "end of run" ; wsem:dataOrigin wsem:SyntheticSimulation .

# Qualitative expressions: clarification until sourced conventions exist.
wsem:PYR_updraft_words a wsem:ClarificationPolicy ;
    skos:altLabel "faible ascendance"@fr, "ascendance modérée"@fr, "forte ascendance"@fr ; wsem:appliesTo wsem:PYR_V .
wsem:PYR_air_mass_words a wsem:ClarificationPolicy ;
    skos:altLabel "air pur"@fr, "air marin"@fr, "air pollué"@fr, "air continental"@fr ; wsem:appliesTo wsem:PYR_N .
wsem:PYR_near_saturation a wsem:ClarificationPolicy ;
    skos:altLabel "air presque saturé"@fr ; wsem:appliesTo wsem:PYR_S0 .

# Derived outputs reported by the pyrcel descriptor (exact conversions of native outputs).
wsem:PyrcelContract wsem:declaresOutput wsem:PYR_Smax_percent, wsem:PYR_Nd_cm3 .

wsem:PYR_Smax_percent a wsem:OutputVariable ;
    skos:prefLabel "Sursaturation maximale (%)"@fr ; wsem:canonicalUnit unit:PERCENT ;
    wsem:derivedFromOutput wsem:PYR_Smax ; wsem:derivationRule "S_max x 100" ; wsem:aggregation wsem:AggMax ; wsem:additive false ;
    wsem:dataOrigin wsem:SyntheticSimulation .

wsem:PYR_Nd_cm3 a wsem:OutputVariable ;
    skos:prefLabel "Gouttelettes activées (cm⁻³)"@fr ; wsem:quantityKind qk:NumberDensity ; wsem:canonicalUnit unit:PER-CentiM3 ;
    wsem:derivedFromOutput wsem:PYR_Nd ; wsem:derivationRule "Nd / 1e6 (m^-3 -> cm^-3)" ; wsem:temporalSupport "end of run" ;
    wsem:dataOrigin wsem:SyntheticSimulation .
